{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
-%}

{% if social_icons %}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- style -%}
  .utility-bar {
    padding-top: {{ section.settings.padding_top | default: 12 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 12 }}px;
    background-color: #000000;
    color: #ffffff;
    font-family: var(--font-body-family);
  }

  .utility-bar .page-width,
  .utility-bar__wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    max-width: var(--page-width, 1240px);
    margin: 0 auto;
    padding-left: 20px !important;
    padding-right: 20px !important;
    box-sizing: border-box;
  }

  .utility-bar__trust-badges {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .utility-bar__trust-item {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.3rem;
    font-weight: 400;
    color: #ffffff;
    text-decoration: none;
    line-height: 1.2;
  }

  .utility-bar__trust-item svg {
    width: 1.6rem;
    height: 1.6rem;
    flex-shrink: 0;
    stroke: #ffffff;
    color: #ffffff;
  }

  .utility-bar__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .utility-bar__pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1.2rem;
    border: 0.1rem solid rgba(255, 255, 255, 0.25);
    border-radius: 0.4rem;
    background: transparent;
    color: #ffffff;
    font-size: 1.3rem;
    font-weight: 500;
    text-decoration: none;
    line-height: 1.3;
    transition: background 0.2s ease, border-color 0.2s ease;
    cursor: pointer;
  }

  .utility-bar__pill-btn:hover {
    border-color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.1);
  }

  .utility-bar__pill-btn svg {
    width: 1.4rem;
    height: 1.4rem;
    stroke: currentColor;
  }

  .utility-bar .localization-form {
    margin: 0;
    padding: 0;
  }

  .utility-bar .localization-selector {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1.2rem;
    border: 0.1rem solid rgba(255, 255, 255, 0.25);
    border-radius: 0.4rem;
    background: transparent;
    color: #ffffff;
    font-size: 1.3rem;
    font-weight: 500;
    text-decoration: none;
    line-height: 1.3;
    min-height: auto;
  }

  .utility-bar .localization-selector:hover {
    border-color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.1);
  }

  .utility-bar .disclosure .localization-form__select .icon-caret {
    position: static;
    height: 0.6rem;
    width: 0.9rem;
    margin-left: 0.4rem;
    color: #ffffff;
  }

  @media screen and (max-width: 989px) {
    .utility-bar {
      display: none;
    }
  }
{%- endstyle -%}

<div
  class="utility-bar color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} utility-bar--bottom-border{% endif %}"
>
  <div class="page-width utility-bar__wrapper">
    <div class="utility-bar__left">
      {%- if section.blocks.size > 0 -%}
        <ul class="utility-bar__trust-badges" role="list">
          {%- for block in section.blocks -%}
            <li class="utility-bar__trust-item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="utility-bar__trust-item link link--text">
              {%- endif -%}

              {%- case block.settings.icon -%}
                {%- when 'shipping' -%}
                  <svg class="icon icon-truck" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                  </svg>
                {%- when 'support' -%}
                  <svg class="icon icon-headset" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
                    <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
                  </svg>
                {%- when 'security' -%}
                  <svg class="icon icon-shield" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <path d="m9 12 2 2 4-4"></path>
                  </svg>
                {%- when 'phone' -%}
                  <svg class="icon icon-phone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                  </svg>
              {%- endcase -%}

              <span>{{ block.settings.text | escape }}</span>

              {%- if block.settings.link != blank -%}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="utility-bar__actions">
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <div class="localization-wrapper">
          <localization-form class="small-hide medium-hide">
            {%- form 'localization', id: 'AnnouncementCountryForm', class: 'localization-form' -%}
              <div>
                <h2 class="visually-hidden" id="AnnouncementCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'AnnouncementCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        </div>
      {%- elsif section.settings.enable_country_selector -%}
        <div class="utility-bar__pill-btn">
          <span>🇺🇸 $ {{ cart.currency.iso_code | default: 'USD' }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.enable_account_link -%}
        <a
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          class="utility-bar__pill-btn link focus-inset"
        >
          <svg class="icon icon-account" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span>
            {%- if customer -%}
              {{ 'customer.account_fallback' | t | default: 'Account' }}
            {%- else -%}
              {{ 'customer.log_in' | t | default: 'Login' }}
            {%- endif -%}
          </span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": false,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.heading_utilities.content"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": true,
      "label": "t:sections.announcement-bar.settings.enable_country_selector.label",
      "info": "t:sections.announcement-bar.settings.enable_country_selector.info"
    },
    {
      "type": "checkbox",
      "id": "enable_account_link",
      "default": true,
      "label": "Enable Login / Account link"
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "options": [
            {
              "value": "shipping",
              "label": "Shipping Truck"
            },
            {
              "value": "support",
              "label": "Support Headset"
            },
            {
              "value": "security",
              "label": "Security Shield"
            },
            {
              "value": "phone",
              "label": "Phone"
            },
            {
              "value": "none",
              "label": "None"
            }
          ],
          "default": "shipping",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "default": "Shipping to over 200 countries",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.announcement-bar.blocks.announcement.settings.text.default",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "trust_badge",
          "settings": {
            "icon": "shipping",
            "text": "Shipping to over 200 countries"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "support",
            "text": "Outstanding Worldwide Support"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "security",
            "text": "100% Secure Checkout"
          }
        }
      ]
    }
  ]
}
{% endschema %}
