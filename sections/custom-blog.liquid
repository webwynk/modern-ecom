    <!-- Dots Pagination Indicators -->
    <div class="blog__dots-container" id="blogDots-{{ section.id }}">
      <button type="button" class="blog__dot is-active" data-index="0" aria-label="Slide 1"></button>
      <button type="button" class="blog__dot" data-index="1" aria-label="Slide 2"></button>
      <button type="button" class="blog__dot" data-index="2" aria-label="Slide 3"></button>
      <button type="button" class="blog__dot" data-index="3" aria-label="Slide 4"></button>
    </div>

  </div>
</section>

<script>
  (function() {
    var sectionId = "{{ section.id }}";
    var track = document.getElementById('blogSliderTrack-' + sectionId);
    var prevBtn = document.getElementById('blogPrevBtn-' + sectionId);
    var nextBtn = document.getElementById('blogNextBtn-' + sectionId);
    var dotsContainer = document.getElementById('blogDots-' + sectionId);
    if (!track) return;

    var dots = dotsContainer ? dotsContainer.querySelectorAll('.blog__dot') : [];

    function updateDots() {
      if (!dots.length) return;
      var scrollLeft = track.scrollLeft;
      var maxScroll = track.scrollWidth - track.clientWidth;
      var progress = maxScroll > 0 ? scrollLeft / maxScroll : 0;
      var activeIdx = Math.min(Math.round(progress * (dots.length - 1)), dots.length - 1);
      
      dots.forEach(function(dot, idx) {
        dot.classList.toggle('is-active', idx === activeIdx);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        var card = track.querySelector('.blog-card');
        var scrollAmount = card ? card.offsetWidth + 20 : 300;
        track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        var card = track.querySelector('.blog-card');
        var scrollAmount = card ? card.offsetWidth + 20 : 300;
        track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });
    }

    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        var idx = parseInt(this.getAttribute('data-index'), 10);
        var maxScroll = track.scrollWidth - track.clientWidth;
        var targetScroll = (maxScroll / (dots.length - 1)) * idx;
        track.scrollTo({ left: targetScroll, behavior: 'smooth' });
      });
    });

    track.addEventListener('scroll', updateDots, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Custom Blog Carousel",
  "tag": "section",
  "class": "section-custom-blog-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Latest Blog & News"
    }
  ],
  "presets": [
    {
      "name": "Custom Blog Carousel"
    }
  ]
}
{% endschema %}
