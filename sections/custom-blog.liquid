{% comment %}
  Custom Modern Blog Carousel Section
  Matching Reference Design:
  - Header with circular nav arrows
  - 4-Card layout on desktop, swipeable carousel on mobile
  - Brand Gold compact category overlay badges (#997A51)
  - Date meta, bold clamped titles, and "Read more >"
  - Valid collection URLs on all cards
  - Interactive slider script with dot pagination
{% endcomment %}

{{ 'component-custom-blog.css' | asset_url | stylesheet_tag }}

<section class="section-custom-blog" id="BlogSection-{{ section.id }}">
  <div class="blog__container">
    
    <!-- Section Header -->
    <div class="blog__header">
      <div class="blog__title-group">
        <h2 class="blog__heading">{{ section.settings.heading | default: 'Our Latest Blog & News' }}</h2>
      </div>

      <div class="blog__nav-buttons">
        <button type="button" class="blog__nav-btn blog__nav-btn--prev" id="blogPrevBtn-{{ section.id }}" aria-label="Previous articles">
          <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button type="button" class="blog__nav-btn blog__nav-btn--next" id="blogNextBtn-{{ section.id }}" aria-label="Next articles">
          <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    </div>

    <!-- Carousel Slider Track -->
    <div class="blog__slider-wrapper">
      <div class="blog__slider-track" id="blogSliderTrack-{{ section.id }}">
        
