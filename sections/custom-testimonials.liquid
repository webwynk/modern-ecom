{% comment %}
  Custom Modern Vertical Auto-Scrolling Testimonials Wall
  - 3 Columns with bidirectional continuous vertical motion
  - Column 1: Scrolls UP
  - Column 2: Scrolls DOWN
  - Column 3: Scrolls UP
  - Top & Bottom Vertical Gradient Fade Masks
{% endcomment %}

{{ 'component-custom-testimonials.css' | asset_url | stylesheet_tag }}

<section class="section-testimonials" id="Testimonials-{{ section.id }}">
  <div class="testimonials__container">
    
    <!-- Section Header -->
    <div class="testimonials__header">
      <h2 class="testimonials__heading">{{ section.settings.heading | default: 'What Our Collectors & Designers Say' }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="testimonials__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <!-- 3-Column Vertical Marquee Wall with Top & Bottom Fade -->
    <div class="testimonials__marquee-wall">
      
