{% schema %}
{
  "name": "Custom Testimonials Wall",
  "tag": "section",
  "class": "section-custom-testimonials-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Collectors & Designers Say"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Verified testimonials from interior designers, collectors, and corporate suites worldwide"
    }
  ],
  "presets": [
    {
      "name": "Custom Testimonials Wall"
    }
  ]
}
{% endschema %}
