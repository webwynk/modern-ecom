          <!-- Set 1 -->
          <div class="testimonial-card">
            <div class="testimonial-card__header">
              <div class="testimonial-user">
                <div class="testimonial-avatar avatar-bg-1">🤠</div>
                <div>
                  <h3 class="testimonial-name">Devon Lane</h3>
                  <p class="testimonial-handle">@devonla</p>
                </div>
              </div>
              <div class="testimonial-rating">
                <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span>5.0</span>
              </div>
            </div>
            <p class="testimonial-quote">
              The hand-knotted Silk & Wool Persian rug exceeded every expectation. The intricate knot density and rich luster reflect true master artisan heritage.
            </p>
          </div>

