{% schema %}
{
  "name": "Custom Testimonials Wall",
  "tag": "section",
  "class": "section-custom-testimonials-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by Over 10,000+ Customers"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real reviews and experiences from our valued customers worldwide"
    }
  ],
  "presets": [
    {
      "name": "Custom Testimonials Wall"
    }
  ]
}
{% endschema %}
