{% comment %}
  Custom Category Slider Carousel
  Features: Card slider with #FFF8F0 background, studio cutout images,
  item count badges, smooth arrow navigation, touch scroll-snap.
{% endcomment %}

{{ 'component-category-slider.css' | asset_url | stylesheet_tag }}

<div class="section-category-slider" id="CategorySlider-{{ section.id }}">
  <div class="category-slider__container">
    <!-- Header: Title + Navigation Arrows -->
    <div class="category-slider__header">
      <div class="category-slider__title-group">
        <h2 class="category-slider__heading">{{ section.settings.heading | default: 'Explore Popular Categories' }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="category-slider__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>

      <div class="category-slider__controls">
        <button
          type="button"
          class="category-slider__arrow category-slider__arrow--prev"
          aria-label="Previous categories"
          id="CatPrev-{{ section.id }}"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button
          type="button"
          class="category-slider__arrow category-slider__arrow--next"
          aria-label="Next categories"
          id="CatNext-{{ section.id }}"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <!-- Category Slider Track -->
    <div class="category-slider__wrapper">
      <div class="category-slider__track" id="CatTrack-{{ section.id }}" role="region" aria-label="Categories Carousel">
        {% for block in section.blocks %}
          {%- liquid
            assign col = block.settings.collection
            assign card_title = block.settings.title
            if card_title == blank and col != blank
              assign card_title = col.title
            endif
            if card_title == blank
              assign card_title = 'Collection'
            endif

            assign card_url = block.settings.link
            if card_url == blank and col != blank
              assign card_url = col.url
            endif
            if card_url == blank
              assign card_url = '/collections/all'
            endif

            assign card_count = block.settings.count
            if card_count == blank and col != blank
              assign card_count = col.all_products_count | append: ' Items'
            endif

            assign card_image = block.settings.image
            if card_image == blank and col != blank and col.featured_image != blank
              assign card_image = col.featured_image
            endif
            if card_image == blank and col != blank and col.products.first.featured_image != blank
              assign card_image = col.products.first.featured_image
            endif
          -%}
          <a
            href="{{ card_url }}"
            class="category-card"
            {{ block.shopify_attributes }}
          >
            <div class="category-card__image-wrapper">
              {% if card_image != blank %}
                <img
                  src="{{ card_image | image_url: width: 320 }}"
                  alt="{{ card_title | escape }}"
                  class="category-card__image"
                  loading="lazy"
                  width="160"
                  height="160"
                >
              {% elsif block.settings.static_image != blank %}
                <img
                  src="{{ block.settings.static_image | asset_url }}"
                  alt="{{ card_title | escape }}"
                  class="category-card__image"
                  loading="lazy"
                  width="160"
                  height="160"
                >
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'category-card__image' }}
              {% endif %}
            </div>
            <h3 class="category-card__title">{{ card_title }}</h3>
            {% if card_count != blank %}
              <span class="category-card__count">{{ card_count }}</span>
            {% endif %}
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    'use strict';
    var sectionId = '{{ section.id }}';
    var track = document.getElementById('CatTrack-' + sectionId);
    var prevBtn = document.getElementById('CatPrev-' + sectionId);
    var nextBtn = document.getElementById('CatNext-' + sectionId);

    if (!track || !prevBtn || !nextBtn) return;

    function getScrollStep() {
      var firstCard = track.querySelector('.category-card');
      if (firstCard) {
        var style = window.getComputedStyle(track);
        var gap = parseFloat(style.gap) || 16;
        return (firstCard.offsetWidth + gap) * 2;
      }
      return 350;
    }

    prevBtn.addEventListener('click', function(e) {
      e.preventDefault();
      track.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', function(e) {
      e.preventDefault();
      track.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
    });
  })();
</script>

{% schema %}
{
  "name": "Category Slider",
  "tag": "section",
  "class": "section-category-slider-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore Popular Categories"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover handcrafted rugs & artisan furniture curated for modern living"
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (Optional Override)"
        },
        {
          "type": "text",
          "id": "static_image",
          "label": "Asset Image Filename (Fallback)",
          "default": "cat-handmade-rugs.jpg"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title (Optional Override)"
        },
        {
          "type": "text",
          "id": "count",
          "label": "Item Count (Optional Override)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link (Optional Override)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Slider",
      "blocks": [
        {
          "type": "category_card",
          "settings": {
            "collection": "handmade-rugs"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "collection": "executive-desks"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "collection": "small-rugs"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "collection": "office-chairs"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "collection": "storage"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "collection": "table"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "collection": "special-collection"
          }
        }
      ]
    }
  ]
}
{% endschema %}
