{% comment %}
  Custom Product Grid with Collection Tabs & Interactive Numbered Pagination
  Features:
    - Full-width #FFF8F0 luxury background, 1240px container
    - Responsive Collection Tab Navigation Bar
    - Modular deal-grid-card snippet rendering
    - Instant 0ms client-side pagination with numbered pills & Prev/Next
    - Automated discount badges, star ratings, wishlist toggles
    - Fallback showcase cards when zero products are in inventory
{% endcomment %}

{{ 'component-product-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign per_page = section.settings.products_per_page | default: 10
  assign has_tab_blocks = false
  for block in section.blocks
    if block.type == 'collection_tab'
      assign has_tab_blocks = true
      break
    endif
  endfor
-%}

<div class="section-product-grid" id="ProductGrid-{{ section.id }}">
  <div class="product-grid__container">
    <!-- Header with Right-Aligned View All Button -->
    <div class="product-grid__header">
      <div class="product-grid__title-group">
        <h2 class="product-grid__heading">{{ section.settings.heading | default: 'Special Collection Deals' }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="product-grid__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>

      {% assign view_all_target = section.settings.view_all_link %}
      {% if view_all_target == blank and section.settings.collection != blank %}
        {% assign view_all_target = section.settings.collection.url %}
      {% endif %}
      {% if view_all_target == blank %}
        {% assign view_all_target = '/collections/all' %}
      {% endif %}

      {% if section.settings.show_view_all %}
        <a href="{{ view_all_target }}" class="product-grid__view-all-btn" id="dealViewAllBtn-{{ section.id }}">
          <span>{{ section.settings.view_all_text | default: 'View All' }}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      {% endif %}
    </div>

    <!-- ========================================
         Collection Tabs Bar (Above Product Grid)
         ======================================== -->
    <div class="deal-tabs-wrapper" role="tablist" aria-label="Product Collections Filter" id="dealTabs-{{ section.id }}">
      {% if has_tab_blocks %}
        {% for block in section.blocks %}
          {% if block.type == 'collection_tab' %}
            {%- liquid
              assign col = block.settings.collection
              if col.title == blank and block.settings.collection != blank
                assign col = collections[block.settings.collection]
              endif
              assign tab_title = block.settings.title
              if tab_title == blank and col != blank
                assign tab_title = col.title
              endif
              if tab_title == blank
                assign tab_title = 'Collection ' | append: forloop.index
              endif
              assign col_count = col.all_products_count | default: col.products.size
            -%}
            <button
              type="button"
              class="deal-tab-btn {% if forloop.first %}is-active{% endif %}"
              data-tab-target="deal-tab-{{ section.id }}-{{ forloop.index }}"
              data-collection-url="{{ col.url | default: '/collections/all' }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              <span>{{ tab_title }}</span>
              {% if col_count > 0 %}
                <span class="deal-tab-btn__count">({{ col_count }})</span>
              {% endif %}
            </button>
          {% endif %}
        {% endfor %}
      {% else %}
        <!-- Default Store Collection Tabs -->
        {%- assign default_tab_handles = "special-collection,handmade-rugs,executive-desks,office-chairs,small-rugs,storage,table" | split: "," -%}
        {% for handle in default_tab_handles %}
          {%- liquid
            assign col = collections[handle]
            assign tab_title = col.title | default: handle | replace: '-', ' ' | capitalize
            assign col_count = col.all_products_count | default: col.products.size
          -%}
          <button
            type="button"
            class="deal-tab-btn {% if forloop.first %}is-active{% endif %}"
            data-tab-target="deal-tab-{{ section.id }}-{{ forloop.index }}"
            data-collection-url="{{ col.url | default: '/collections/all' }}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            <span>{{ tab_title }}</span>
            {% if col_count > 0 %}
              <span class="deal-tab-btn__count">({{ col_count }})</span>
            {% endif %}
          </button>
        {% endfor %}
      {% endif %}
    </div>

    <!-- ========================================
         Tab Panels & Paginated Product Grids
         ======================================== -->
    <div class="deal-tab-panels-wrapper" id="dealPanels-{{ section.id }}">
      {% if has_tab_blocks %}
        {% for block in section.blocks %}
          {% if block.type == 'collection_tab' %}
            {%- liquid
              assign col = block.settings.collection
              if col.title == blank and block.settings.collection != blank
                assign col = collections[block.settings.collection]
              endif
              if col == blank or col.title == blank
                assign col = collections['special-collection']
              endif
              if col == blank or col.all_products_count == 0
                assign col = collections['all']
              endif

              assign prod_count = col.products.size
              assign total_pages = prod_count | times: 1.0 | divided_by: per_page | ceil
            -%}
            <div
              class="deal-tab-panel {% if forloop.first %}is-active{% endif %}"
              id="deal-tab-{{ section.id }}-{{ forloop.index }}"
              data-total-pages="{{ total_pages }}"
              data-current-page="1"
              role="tabpanel"
            >
              <ul class="product-grid__items" role="list">
                {% if prod_count > 0 %}
                  {% for product in col.products limit: 50 %}
                    {% assign page_num = forloop.index0 | divided_by: per_page | plus: 1 %}
                    {% render 'deal-grid-card', product: product, page_num: page_num %}
                  {% endfor %}
                {% else %}
                  <!-- Fallback showcase cards when zero live products are in inventory -->
                  {% for i in (1..10) %}
                    {% assign page_num = forloop.index0 | divided_by: per_page | plus: 1 %}
                    <li class="deal-grid-card {% if page_num == 1 %}is-page-visible{% endif %}" data-page="{{ page_num }}" data-product-id="fb-{{ i }}">
                      <div class="deal-grid-card__top">
                        <span class="deal-grid-card__badge">SAVE 25%</span>
                        <button type="button" class="deal-grid-card__wishlist" aria-label="Add to wishlist" onclick="toggleDealWishlist(this, 'fb-{{ i }}');">
                          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                        </button>
                      </div>
                      <a href="/collections/special-collection" class="deal-grid-card__media">
                        <img src="{{ 'cat-handmade-rugs.jpg' | asset_url }}" alt="Handcrafted Product Deal" class="deal-grid-card__image" loading="lazy" width="200" height="200">
                      </a>
                      <div class="deal-grid-card__meta">
                        <span class="deal-grid-card__sku">SKU: SP-0{{ i }}</span>
                        <div class="deal-grid-card__rating">
                          <svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                          <span>4.9 (12{{ i }})</span>
                        </div>
                      </div>
                      <a href="/collections/special-collection" style="text-decoration: none;">
                        <h3 class="deal-grid-card__title">Special Handcrafted Collection Piece #{{ i }}</h3>
                      </a>
                      <div class="deal-grid-card__pricing">
                        <span class="deal-grid-card__price">$899.00</span>
                        <span class="deal-grid-card__old-price">$1,199.00</span>
                      </div>
                      <a href="/collections/special-collection" class="deal-grid-card__btn">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                        <span>Buy Now</span>
                      </a>
                    </li>
                  {% endfor %}
                {% endif %}
              </ul>

              <!-- Pagination Controls for this Tab Panel -->
              {% if section.settings.enable_pagination and total_pages > 1 %}
                <div class="deal-pagination" aria-label="Pagination">
                  <button type="button" class="deal-pagination__nav-btn deal-pagination__prev" disabled aria-label="Previous page">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    <span>Prev</span>
                  </button>
                  <div class="deal-pagination__pages">
                    {% for p in (1..total_pages) %}
                      <button
                        type="button"
                        class="deal-pagination__page-btn {% if forloop.first %}is-active{% endif %}"
                        data-page-target="{{ p }}"
                        aria-label="Go to page {{ p }}"
                        {% if forloop.first %}aria-current="page"{% endif %}
                      >
                        {{ p }}
                      </button>
                    {% endfor %}
                  </div>
                  <button type="button" class="deal-pagination__nav-btn deal-pagination__next" aria-label="Next page">
                    <span>Next</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                  </button>
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      {% else %}
        <!-- Default Panels for Store Collections -->
        {%- assign default_tab_handles = "special-collection,handmade-rugs,executive-desks,office-chairs,small-rugs,storage,table" | split: "," -%}
        {% for handle in default_tab_handles %}
          {%- liquid
            assign col = collections[handle]
            if col == blank or col.all_products_count == 0
              if forloop.first
                assign col = collections['all']
              endif
            endif

            assign prod_count = col.products.size
            assign total_pages = prod_count | times: 1.0 | divided_by: per_page | ceil
            if total_pages < 1
              assign total_pages = 1
            endif
          -%}
          <div
            class="deal-tab-panel {% if forloop.first %}is-active{% endif %}"
            id="deal-tab-{{ section.id }}-{{ forloop.index }}"
            data-total-pages="{{ total_pages }}"
            data-current-page="1"
            role="tabpanel"
          >
            <ul class="product-grid__items" role="list">
              {% if prod_count > 0 %}
                {% for product in col.products limit: 50 %}
                  {% assign page_num = forloop.index0 | divided_by: per_page | plus: 1 %}
                  {% render 'deal-grid-card', product: product, page_num: page_num %}
                {% endfor %}
              {% else %}
                {% for i in (1..10) %}
                  {% assign page_num = forloop.index0 | divided_by: per_page | plus: 1 %}
                  <li class="deal-grid-card {% if page_num == 1 %}is-page-visible{% endif %}" data-page="{{ page_num }}" data-product-id="def-{{ handle }}-{{ i }}">
                    <div class="deal-grid-card__top">
                      <span class="deal-grid-card__badge">SAVE 25%</span>
                      <button type="button" class="deal-grid-card__wishlist" aria-label="Add to wishlist" onclick="toggleDealWishlist(this, 'def-{{ handle }}-{{ i }}');">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                      </button>
                    </div>
                    <a href="{{ col.url | default: '/collections/special-collection' }}" class="deal-grid-card__media">
                      <img src="{{ 'cat-handmade-rugs.jpg' | asset_url }}" alt="Handcrafted Deal" class="deal-grid-card__image" loading="lazy" width="200" height="200">
                    </a>
                    <div class="deal-grid-card__meta">
                      <span class="deal-grid-card__sku">SKU: {{ handle | slice: 0, 2 | upcase }}-{{ i }}01</span>
                      <div class="deal-grid-card__rating">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                        <span>4.9 (12{{ i }})</span>
                      </div>
                    </div>
                    <a href="{{ col.url | default: '/collections/special-collection' }}" style="text-decoration: none;">
                      <h3 class="deal-grid-card__title">{{ col.title | default: handle | capitalize }} Showcase Piece #{{ i }}</h3>
                    </a>
                    <div class="deal-grid-card__pricing">
                      <span class="deal-grid-card__price">$899.00</span>
                      <span class="deal-grid-card__old-price">$1,199.00</span>
                    </div>
                    <a href="{{ col.url | default: '/collections/special-collection' }}" class="deal-grid-card__btn">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                      <span>Buy Now</span>
                    </a>
                  </li>
                {% endfor %}
              {% endif %}
            </ul>

            <!-- Pagination Controls for Default Panels -->
            {% if section.settings.enable_pagination and total_pages > 1 %}
              <div class="deal-pagination" aria-label="Pagination">
                <button type="button" class="deal-pagination__nav-btn deal-pagination__prev" disabled aria-label="Previous page">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
                  <span>Prev</span>
                </button>
                <div class="deal-pagination__pages">
                  {% for p in (1..total_pages) %}
                    <button
                      type="button"
                      class="deal-pagination__page-btn {% if forloop.first %}is-active{% endif %}"
                      data-page-target="{{ p }}"
                      aria-label="Go to page {{ p }}"
                      {% if forloop.first %}aria-current="page"{% endif %}
                    >
                      {{ p }}
                    </button>
                  {% endfor %}
                </div>
                <button type="button" class="deal-pagination__nav-btn deal-pagination__next" aria-label="Next page">
                  <span>Next</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </button>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

<script>
  function toggleDealWishlist(btn, id) {
    btn.classList.toggle('is-active');
    var isLiked = btn.classList.contains('is-active');
    try {
      var key = 'wishlist_' + id;
      if (isLiked) {
        localStorage.setItem(key, 'true');
      } else {
        localStorage.removeItem(key);
      }
    } catch(e) {}
  }

  (function() {
    function initDealGrid() {
      var sectionEl = document.getElementById('ProductGrid-{{ section.id }}');
      if (!sectionEl) return;

      var tabButtons = sectionEl.querySelectorAll('.deal-tab-btn');
      var panels = sectionEl.querySelectorAll('.deal-tab-panel');
      var viewAllBtn = document.getElementById('dealViewAllBtn-{{ section.id }}');

      // Tab Switching Handler
      tabButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var targetPanelId = this.getAttribute('data-tab-target');
          var colUrl = this.getAttribute('data-collection-url');

          tabButtons.forEach(function(b) {
            b.classList.remove('is-active');
            b.setAttribute('aria-selected', 'false');
          });
          this.classList.add('is-active');
          this.setAttribute('aria-selected', 'true');

          panels.forEach(function(panel) {
            if (panel.id === targetPanelId) {
              panel.classList.add('is-active');
              setPanelPage(panel, 1, false);
            } else {
              panel.classList.remove('is-active');
            }
          });

          // Update View All link to point to current tab collection
          if (viewAllBtn && colUrl) {
            viewAllBtn.setAttribute('href', colUrl);
          }
        });
      });

      // Pagination Click Handlers
      panels.forEach(function(panel) {
        var pagination = panel.querySelector('.deal-pagination');
        if (!pagination) return;

        var prevBtn = pagination.querySelector('.deal-pagination__prev');
        var nextBtn = pagination.querySelector('.deal-pagination__next');
        var pageBtns = pagination.querySelectorAll('.deal-pagination__page-btn');

        pageBtns.forEach(function(pBtn) {
          pBtn.addEventListener('click', function() {
            var targetPage = parseInt(this.getAttribute('data-page-target'), 10);
            setPanelPage(panel, targetPage, true);
          });
        });

        if (prevBtn) {
          prevBtn.addEventListener('click', function() {
            var curr = parseInt(panel.getAttribute('data-current-page') || '1', 10);
            if (curr > 1) {
              setPanelPage(panel, curr - 1, true);
            }
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', function() {
            var curr = parseInt(panel.getAttribute('data-current-page') || '1', 10);
            var total = parseInt(panel.getAttribute('data-total-pages') || '1', 10);
            if (curr < total) {
              setPanelPage(panel, curr + 1, true);
            }
          });
        }
      });

      function setPanelPage(panel, pageNum, doScroll) {
        panel.setAttribute('data-current-page', pageNum);
        var totalPages = parseInt(panel.getAttribute('data-total-pages') || '1', 10);

        // Update cards visibility
        var cards = panel.querySelectorAll('.deal-grid-card[data-page]');
        cards.forEach(function(card) {
          var cardPage = parseInt(card.getAttribute('data-page'), 10);
          if (cardPage === pageNum) {
            card.classList.add('is-page-visible');
          } else {
            card.classList.remove('is-page-visible');
          }
        });

        // Update pagination buttons state
        var pagination = panel.querySelector('.deal-pagination');
        if (pagination) {
          var prevBtn = pagination.querySelector('.deal-pagination__prev');
          var nextBtn = pagination.querySelector('.deal-pagination__next');
          var pageBtns = pagination.querySelectorAll('.deal-pagination__page-btn');

          if (prevBtn) {
            prevBtn.disabled = (pageNum <= 1);
            if (pageNum <= 1) {
              prevBtn.classList.add('is-disabled');
            } else {
              prevBtn.classList.remove('is-disabled');
            }
          }

          if (nextBtn) {
            nextBtn.disabled = (pageNum >= totalPages);
            if (pageNum >= totalPages) {
              nextBtn.classList.add('is-disabled');
            } else {
              nextBtn.classList.remove('is-disabled');
            }
          }

          pageBtns.forEach(function(btn) {
            var p = parseInt(btn.getAttribute('data-page-target'), 10);
            if (p === pageNum) {
              btn.classList.add('is-active');
              btn.setAttribute('aria-current', 'page');
            } else {
              btn.classList.remove('is-active');
              btn.removeAttribute('aria-current');
            }
          });
        }

        // Smooth scroll to top of section on user pagination click
        if (doScroll) {
          var header = sectionEl.querySelector('.product-grid__header');
          if (header) {
            header.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      }

      // Restore liked states on page load
      var wishlistButtons = sectionEl.querySelectorAll('.deal-grid-card__wishlist');
      wishlistButtons.forEach(function(btn) {
        var card = btn.closest('.deal-grid-card');
        if (card) {
          var id = card.getAttribute('data-product-id');
          if (id && localStorage.getItem('wishlist_' + id) === 'true') {
            btn.classList.add('is-active');
          }
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDealGrid);
    } else {
      initDealGrid();
    }
  })();
</script>

{% schema %}
{
  "name": "Featured Deals Grid",
  "tag": "section",
  "class": "section-product-grid-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Special Collection Deals"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated selection of handcrafted rugs and premium executive office furniture"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Default Collection"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 5,
      "max": 25,
      "step": 5,
      "default": 10,
      "label": "Products per page"
    },
    {
      "type": "checkbox",
      "id": "enable_pagination",
      "label": "Enable Pagination",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Button Text",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link (Leave blank for collection URL)"
    }
  ],
  "blocks": [
    {
      "type": "collection_tab",
      "name": "Collection Tab",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Tab Title Override (Optional)"
        }
      ]
    },
    {
      "type": "product_card",
      "name": "Product Deal Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Product Title",
          "default": "Hand-Knotted Isfahan Wool & Silk Rug"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Sale Price",
          "default": "$899.00"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Deals Grid",
      "settings": {
        "heading": "Special Collection Deals",
        "subheading": "Curated selection of handcrafted rugs and premium executive office furniture",
        "products_per_page": 10,
        "enable_pagination": true
      },
      "blocks": [
        {
          "type": "collection_tab",
          "settings": {
            "collection": "special-collection",
            "title": "Special Collection"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "collection": "handmade-rugs",
            "title": "Handmade Rugs"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "collection": "executive-desks",
            "title": "Executive Desks"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "collection": "office-chairs",
            "title": "Office Chairs"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "collection": "small-rugs",
            "title": "Small Rugs"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "collection": "storage",
            "title": "Storage"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "collection": "table",
            "title": "Tables"
          }
        }
      ]
    }
  ]
}
{% endschema %}
