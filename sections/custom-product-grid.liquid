{% comment %}
  Custom 10-Product Deals Grid
  Features: Full-width #FFF8F0 background, 1240px container,
  80px/50px padding, custom card with discount badge, wishlist heart,
  star rating, 2-line title clamp, sale/old price, and Buy Now button.
{% endcomment %}

{{ 'component-product-grid.css' | asset_url | stylesheet_tag }}

<div class="section-product-grid" id="ProductGrid-{{ section.id }}">
  <div class="product-grid__container">
    <!-- Header with Right-Aligned View All Button -->
    <div class="product-grid__header">
      <div class="product-grid__title-group">
        <h2 class="product-grid__heading">{{ section.settings.heading | default: 'Special Collection Deals' }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="product-grid__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>

      {% assign view_all_target = section.settings.view_all_link %}
      {% if view_all_target == blank and section.settings.collection != blank %}
        {% assign view_all_target = section.settings.collection.url %}
      {% endif %}
      {% if view_all_target == blank %}
        {% assign view_all_target = '/collections/all' %}
      {% endif %}

      {% if section.settings.show_view_all %}
        <a href="{{ view_all_target }}" class="product-grid__view-all-btn">
          <span>{{ section.settings.view_all_text | default: 'View All' }}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      {% endif %}
    </div>

    <!-- 10-Product Grid -->
    <ul class="product-grid__items" role="list">
      {%- assign featured_collection = section.settings.collection -%}
      {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
        {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
          <li class="deal-grid-card" data-product-id="{{ product.id }}">
            <!-- Top Row: Badge + Wishlist Button -->
            <div class="deal-grid-card__top">
              {%- if product.compare_at_price > product.price -%}
                {%- assign save_percent = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
                <span class="deal-grid-card__badge">
                  SAVE {{ save_percent }}%
                </span>
              {%- elsif product.tags contains 'HOT' or product.tags contains 'Hot' or product.tags contains 'hot' -%}
                <span class="deal-grid-card__badge">HOT!</span>
              {%- elsif product.tags contains 'NEW' or product.tags contains 'New' or product.tags contains 'new' -%}
                <span class="deal-grid-card__badge deal-grid-card__badge--gold">NEW</span>
              {%- else -%}
                <span></span>
              {%- endif -%}

              <button
                type="button"
                class="deal-grid-card__wishlist"
                aria-label="Add {{ product.title | escape }} to wishlist"
                onclick="toggleDealWishlist(this, '{{ product.id }}');"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </button>
            </div>

            <!-- Product Image -->
            <a href="{{ product.url }}" class="deal-grid-card__media" aria-label="{{ product.title | escape }}">
              {%- if product.featured_media != blank -%}
                <img
                  src="{{ product.featured_media | image_url: width: 400 }}"
                  alt="{{ product.featured_media.alt | default: product.title | escape }}"
                  class="deal-grid-card__image"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'deal-grid-card__image' }}
              {%- endif -%}
            </a>

            <!-- Meta: SKU + Rating -->
            <div class="deal-grid-card__meta">
              <span class="deal-grid-card__sku">
                {%- if product.selected_or_first_available_variant.sku != blank -%}
                  SKU: {{ product.selected_or_first_available_variant.sku }}
                {%- else -%}
                  SKU: PR-{{ product.id | slice: -4, 4 }}
                {%- endif -%}
              </span>
              <div class="deal-grid-card__rating">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
                <span>
                  {%- if product.metafields.reviews.rating.value != blank -%}
                    {{ product.metafields.reviews.rating.value | round: 1 }} ({{ product.metafields.reviews.rating_count | default: 1 }})
                  {%- else -%}
                    4.9 ({{ product.id | slice: -2, 2 | plus: 20 }})
                  {%- endif -%}
                </span>
              </div>
            </div>

            <!-- Title (2-Line Limit) -->
            <a href="{{ product.url }}" style="text-decoration: none;">
              <h3 class="deal-grid-card__title">{{ product.title }}</h3>
            </a>

            <!-- Pricing -->
            <div class="deal-grid-card__pricing">
              <span class="deal-grid-card__price">{{ product.price | money }}</span>
              {%- if product.compare_at_price > product.price -%}
                <span class="deal-grid-card__old-price">{{ product.compare_at_price | money }}</span>
              {%- endif -%}
            </div>

            <!-- Buy Now CTA -->
            <a href="{{ product.url }}" class="deal-grid-card__btn">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
              <span>Buy Now</span>
            </a>
          </li>
        {%- endfor -%}
      {%- elsif section.blocks.size > 0 -%}
        {% for block in section.blocks %}
          <li class="deal-grid-card" {{ block.shopify_attributes }}>
            <!-- Top Row: Badge + Wishlist Button -->
            <div class="deal-grid-card__top">
              {% if block.settings.badge != blank %}
                <span class="deal-grid-card__badge {% if block.settings.badge_style == 'gold' %}deal-grid-card__badge--gold{% endif %}">
                  {{ block.settings.badge }}
                </span>
              {% else %}
                <span></span>
              {% endif %}

              <button
                type="button"
                class="deal-grid-card__wishlist"
                aria-label="Add {{ block.settings.title | escape }} to wishlist"
                onclick="toggleDealWishlist(this, '{{ block.id }}');"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </button>
            </div>

            <!-- Product Image -->
            <a href="{{ block.settings.link | default: '/collections/all' }}" class="deal-grid-card__media" aria-label="{{ block.settings.title | escape }}">
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 400 }}"
                  alt="{{ block.settings.title | escape }}"
                  class="deal-grid-card__image"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              {% elsif block.settings.static_image != blank %}
                <img
                  src="{{ block.settings.static_image | asset_url }}"
                  alt="{{ block.settings.title | escape }}"
                  class="deal-grid-card__image"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'deal-grid-card__image' }}
              {% endif %}
            </a>

            <!-- Meta: SKU + Rating -->
            <div class="deal-grid-card__meta">
              <span class="deal-grid-card__sku">{{ block.settings.sku | default: 'SKU: GR-8820' }}</span>
              <div class="deal-grid-card__rating">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
                <span>{{ block.settings.rating | default: '4.9' }} ({{ block.settings.rating_count | default: '128' }})</span>
              </div>
            </div>

            <!-- Title (2-Line Limit) -->
            <a href="{{ block.settings.link | default: '/collections/all' }}" style="text-decoration: none;">
              <h3 class="deal-grid-card__title">{{ block.settings.title }}</h3>
            </a>

            <!-- Pricing -->
            <div class="deal-grid-card__pricing">
              <span class="deal-grid-card__price">{{ block.settings.price | default: '$499.00' }}</span>
              {% if block.settings.old_price != blank %}
                <span class="deal-grid-card__old-price">{{ block.settings.old_price }}</span>
              {% endif %}
            </div>

            <!-- Buy Now CTA -->
            <a href="{{ block.settings.link | default: '/collections/all' }}" class="deal-grid-card__btn">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
              <span>Buy Now</span>
            </a>
          </li>
        {% endfor %}
      {%- endif -%}
    </ul>
  </div>
</div>

<script>
  function toggleDealWishlist(btn, id) {
    btn.classList.toggle('is-active');
    var isLiked = btn.classList.contains('is-active');
    try {
      var key = 'wishlist_' + id;
      if (isLiked) {
        localStorage.setItem(key, 'true');
      } else {
        localStorage.removeItem(key);
      }
    } catch(e) {}
  }

  // Restore liked states on page load
  document.addEventListener('DOMContentLoaded', function() {
    var buttons = document.querySelectorAll('.deal-grid-card__wishlist');
    buttons.forEach(function(btn) {
      var card = btn.closest('.deal-grid-card');
      if (card) {
        var id = card.getAttribute('data-product-id') || card.getAttribute('data-block-id');
        if (id && localStorage.getItem('wishlist_' + id) === 'true') {
          btn.classList.add('is-active');
        }
      }
    });
  });
</script>

{% schema %}
{
  "name": "Featured Deals Grid",
  "tag": "section",
  "class": "section-product-grid-wrapper",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 25,
      "step": 1,
      "default": 10,
      "label": "Maximum products to show"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Special Collection Deals"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated selection of handcrafted rugs and premium executive office furniture"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Button Text",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link (Leave blank for collection URL)"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Deal Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "static_image",
          "label": "Asset Image Filename (Fallback)",
          "default": "cat-handmade-rugs.jpg"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Discount Badge",
          "default": "SAVE 25%"
        },
        {
          "type": "select",
          "id": "badge_style",
          "label": "Badge Color Style",
          "options": [
            { "value": "red", "label": "Red Deal" },
            { "value": "gold", "label": "Gold Highlight" }
          ],
          "default": "red"
        },
        {
          "type": "text",
          "id": "sku",
          "label": "SKU",
          "default": "SKU: GR-1082"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product Title",
          "default": "Hand-Knotted Isfahan Wool & Silk Rug"
        },
        {
          "type": "text",
          "id": "rating",
          "label": "Rating Score",
          "default": "4.9"
        },
        {
          "type": "text",
          "id": "rating_count",
          "label": "Rating Count",
          "default": "128"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Sale Price",
          "default": "$899.00"
        },
        {
          "type": "text",
          "id": "old_price",
          "label": "Old Price",
          "default": "$1,199.00"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Deals Grid",
      "settings": {
        "title": "Special Collection Deals",
        "subheading": "Curated selection of handcrafted rugs and premium executive office furniture",
        "products_to_show": 10
      }
    }
  ]
}
{% endschema %}
