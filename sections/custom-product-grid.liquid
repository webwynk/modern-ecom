{% comment %}
  Custom Product Grid with Collection Tabs & Interactive Numbered Pagination
  Features:
    - Full-width #FFF8F0 luxury background, 1240px container
    - Responsive Collection Tab Navigation Bar
    - Modular deal-grid-card snippet rendering
    - Instant 0ms client-side pagination with numbered pills & Prev/Next
    - Automated discount badges, star ratings, wishlist toggles
    - Fallback showcase cards when zero products are in inventory
{% endcomment %}

{{ 'component-product-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign per_page = section.settings.products_per_page | default: 10
  assign has_tab_blocks = false
  for block in section.blocks
    if block.type == 'collection_tab'
      assign has_tab_blocks = true
      break
    endif
  endfor
-%}

<div class="section-product-grid" id="ProductGrid-{{ section.id }}">
  <div class="product-grid__container">
    <!-- Header with Right-Aligned Category Tab Navigation Arrows -->
    <div class="product-grid__header">
      <div class="product-grid__title-group">
        <h2 class="product-grid__heading">{{ section.settings.heading | default: 'Special Collection Deals' }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="product-grid__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>

      {% if section.settings.show_tab_arrows != false %}
        <div class="product-grid__controls" aria-label="Category Tab Navigation">
          <button
            type="button"
            class="product-grid__arrow product-grid__arrow--prev"
            aria-label="Previous category tab"
            id="TabPrev-{{ section.id }}"
            title="Previous collection"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button
            type="button"
            class="product-grid__arrow product-grid__arrow--next"
            aria-label="Next category tab"
            id="TabNext-{{ section.id }}"
            title="Next collection"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      {% endif %}
    </div>

    <!-- ========================================
         Collection Tabs Bar (Above Product Grid)
         ======================================== -->
    <div class="deal-tabs-wrapper" role="tablist" aria-label="Product Collections Filter" id="dealTabs-{{ section.id }}">
      {% if has_tab_blocks %}
        {%- assign rendered_tab_count = 0 -%}
        {% for block in section.blocks %}
          {% if block.type == 'collection_tab' %}
            {%- liquid
              assign col = block.settings.collection
              if col.title == blank and block.settings.collection != blank
                assign col = collections[block.settings.collection]
              endif

              assign col_count = col.all_products_count | default: 0
            -%}
            {%- comment %} Strictly omit any collection with 0 products or invalid collection {% endcomment -%}
            {%- if col == blank or col_count == 0 -%}
              {%- continue -%}
            {%- endif -%}
            {%- assign rendered_tab_count = rendered_tab_count | plus: 1 -%}
            {%- liquid
              assign tab_title = block.settings.title
              if tab_title == blank and col != blank and col.title != blank
                assign tab_title = col.title
              endif
              if tab_title == blank
                assign tab_title = 'Collection ' | append: rendered_tab_count
              endif
            -%}
            <button
              type="button"
              class="deal-tab-btn {% if rendered_tab_count == 1 %}is-active{% endif %}"
              data-tab-target="deal-tab-{{ section.id }}-{{ block.id }}"
              data-collection-url="{{ col.url | default: '/collections/all' }}"
              role="tab"
              aria-selected="{% if rendered_tab_count == 1 %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              <span>{{ tab_title }}</span>
              <span class="deal-tab-btn__count">({{ col_count }})</span>
            </button>
          {% endif %}
        {% endfor %}
      {% endif %}

      {% if has_tab_blocks == false or rendered_tab_count == 0 %}
        <!-- Dynamic Store Collection Tabs (Strictly showing collections with > 0 products) -->
        {%- assign rendered_tabs = 0 -%}
        {% for col in collections %}
          {% if col.all_products_count > 0 and col.handle != 'all' %}
            {%- assign rendered_tabs = rendered_tabs | plus: 1 -%}
            <button
              type="button"
              class="deal-tab-btn {% if rendered_tabs == 1 %}is-active{% endif %}"
              data-tab-target="deal-tab-{{ section.id }}-col-{{ col.id }}"
              data-collection-url="{{ col.url | default: '/collections/all' }}"
              role="tab"
              aria-selected="{% if rendered_tabs == 1 %}true{% else %}false{% endif %}"
            >
              <span>{{ col.title }}</span>
              <span class="deal-tab-btn__count">({{ col.all_products_count }})</span>
            </button>
            {% if rendered_tabs >= 8 %}{% break %}{% endif %}
          {% endif %}
        {% endfor %}
        {% if rendered_tabs == 0 %}
          <button
            type="button"
            class="deal-tab-btn is-active"
            data-tab-target="deal-tab-{{ section.id }}-all"
            data-collection-url="/collections/all"
            role="tab"
            aria-selected="true"
          >
            <span>All Products</span>
          </button>
        {% endif %}
      {% endif %}
    </div>

    <!-- ========================================
         Tab Panels & Paginated Product Grids
         ======================================== -->
    <div class="deal-tab-panels-wrapper" id="dealPanels-{{ section.id }}">
      {% if has_tab_blocks %}
        {%- assign rendered_panel_count = 0 -%}
        {% for block in section.blocks %}
          {% if block.type == 'collection_tab' %}
            {%- liquid
              assign col = block.settings.collection
              if col.title == blank and block.settings.collection != blank
                assign col = collections[block.settings.collection]
              endif

              assign prod_count = col.all_products_count | default: 0
            -%}
            {%- comment %} Strictly omit any collection with 0 products or invalid collection {% endcomment -%}
            {%- if col == blank or prod_count == 0 -%}
              {%- continue -%}
            {%- endif -%}
            {%- assign rendered_panel_count = rendered_panel_count | plus: 1 -%}
            {%- liquid
              assign total_pages = prod_count | times: 1.0 | divided_by: per_page | ceil
              if total_pages < 1
                assign total_pages = 1
              endif
            -%}
            <div
              class="deal-tab-panel {% if rendered_panel_count == 1 %}is-active{% endif %}"
              id="deal-tab-{{ section.id }}-{{ block.id }}"
              data-total-pages="{{ total_pages }}"
              data-current-page="1"
              role="tabpanel"
            >
              <ul class="product-grid__items" role="list">
                {% for product in col.products limit: 50 %}
                  {% assign page_num = forloop.index0 | divided_by: per_page | plus: 1 %}
                  {% render 'deal-grid-card', product: product, page_num: page_num %}
                {% endfor %}
              </ul>

              <!-- Pagination Controls for this Tab Panel -->
              {% if section.settings.enable_pagination and total_pages > 1 and prod_count > 0 %}
                <div class="deal-pagination" aria-label="Pagination">
                  <button type="button" class="deal-pagination__nav-btn deal-pagination__prev" disabled aria-label="Previous page">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    <span>Prev</span>
                  </button>
                  <div class="deal-pagination__pages">
                    {% for p in (1..total_pages) %}
                      <button
                        type="button"
                        class="deal-pagination__page-btn {% if forloop.first %}is-active{% endif %}"
                        data-page-target="{{ p }}"
                        aria-label="Go to page {{ p }}"
                        {% if forloop.first %}aria-current="page"{% endif %}
                      >
                        {{ p }}
                      </button>
                    {% endfor %}
                  </div>
                  <button type="button" class="deal-pagination__nav-btn deal-pagination__next" aria-label="Next page">
                    <span>Next</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                  </button>
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      {% endif %}

      {% if has_tab_blocks == false or rendered_panel_count == 0 %}
        <!-- Dynamic Store Collection Panels -->
        {%- assign rendered_panels = 0 -%}
        {% for col in collections %}
          {% if col.all_products_count > 0 and col.handle != 'all' %}
            {%- assign rendered_panels = rendered_panels | plus: 1 -%}
            {%- liquid
              assign prod_count = col.all_products_count | default: 0
              assign total_pages = prod_count | times: 1.0 | divided_by: per_page | ceil
              if total_pages < 1
                assign total_pages = 1
              endif
            -%}
            <div
              class="deal-tab-panel {% if rendered_panels == 1 %}is-active{% endif %}"
              id="deal-tab-{{ section.id }}-col-{{ col.id }}"
              data-total-pages="{{ total_pages }}"
              data-current-page="1"
              role="tabpanel"
            >
              <ul class="product-grid__items" role="list">
                {% for product in col.products limit: 50 %}
                  {% assign page_num = forloop.index0 | divided_by: per_page | plus: 1 %}
                  {% render 'deal-grid-card', product: product, page_num: page_num %}
                {% endfor %}
              </ul>

              {% if section.settings.enable_pagination and total_pages > 1 and prod_count > 0 %}
                <div class="deal-pagination" aria-label="Pagination">
                  <button type="button" class="deal-pagination__nav-btn deal-pagination__prev" disabled aria-label="Previous page">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    <span>Prev</span>
                  </button>
                  <div class="deal-pagination__pages">
                    {% for p in (1..total_pages) %}
                      <button
                        type="button"
                        class="deal-pagination__page-btn {% if forloop.first %}is-active{% endif %}"
                        data-page-target="{{ p }}"
                        aria-label="Go to page {{ p }}"
                        {% if forloop.first %}aria-current="page"{% endif %}
                      >
                        {{ p }}
                      </button>
                    {% endfor %}
                  </div>
                  <button type="button" class="deal-pagination__nav-btn deal-pagination__next" aria-label="Next page">
                    <span>Next</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                  </button>
                </div>
              {% endif %}
            </div>
            {% if rendered_panels >= 8 %}{% break %}{% endif %}
          {% endif %}
        {% endfor %}
        {% if rendered_panels == 0 %}
          <div
            class="deal-tab-panel is-active"
            id="deal-tab-{{ section.id }}-all"
            data-total-pages="1"
            data-current-page="1"
            role="tabpanel"
          >
            {% assign all_col = collections['all'] %}
            {% assign prod_count = all_col.products.size | default: 0 %}
            {% if prod_count > 0 %}
              <ul class="product-grid__items" role="list">
                {% for product in all_col.products limit: 50 %}
                  {% assign page_num = forloop.index0 | divided_by: per_page | plus: 1 %}
                  {% render 'deal-grid-card', product: product, page_num: page_num %}
                {% endfor %}
              </ul>
            {% else %}
              <div class="product-grid__empty-container">
                <svg class="product-grid__empty-icon" viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="9" cy="21" r="1"></circle>
                  <circle cx="20" cy="21" r="1"></circle>
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
                <p class="product-grid__empty-title">No products found in this store</p>
                <p class="product-grid__empty-desc">Create products in your Shopify Admin to display them here.</p>
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>

<script>
  function toggleDealWishlist(btn, id) {
    btn.classList.toggle('is-active');
    var isLiked = btn.classList.contains('is-active');
    try {
      var key = 'wishlist_' + id;
      if (isLiked) {
        localStorage.setItem(key, 'true');
      } else {
        localStorage.removeItem(key);
      }
    } catch(e) {}
  }

  (function() {
    function initDealGrid() {
      var sectionEl = document.getElementById('ProductGrid-{{ section.id }}');
      if (!sectionEl) return;

      var tabButtons = sectionEl.querySelectorAll('.deal-tab-btn');
      var panels = sectionEl.querySelectorAll('.deal-tab-panel');
      var tabPrevBtn = document.getElementById('TabPrev-{{ section.id }}');
      var tabNextBtn = document.getElementById('TabNext-{{ section.id }}');
      var tabsWrapper = sectionEl.querySelector('.deal-tabs-wrapper');

      function getActiveTabIndex() {
        for (var i = 0; i < tabButtons.length; i++) {
          if (tabButtons[i].classList.contains('is-active')) {
            return i;
          }
        }
        return 0;
      }

      function updateTabArrowStates() {
        if (!tabPrevBtn || !tabNextBtn || tabButtons.length === 0) return;
        var activeIdx = getActiveTabIndex();

        tabPrevBtn.disabled = (activeIdx <= 0);
        if (activeIdx <= 0) {
          tabPrevBtn.classList.add('is-disabled');
        } else {
          tabPrevBtn.classList.remove('is-disabled');
        }

        tabNextBtn.disabled = (activeIdx >= tabButtons.length - 1);
        if (activeIdx >= tabButtons.length - 1) {
          tabNextBtn.classList.add('is-disabled');
        } else {
          tabNextBtn.classList.remove('is-disabled');
        }
      }

      function activateTabByIndex(index) {
        if (index < 0 || index >= tabButtons.length) return;
        var targetBtn = tabButtons[index];
        if (targetBtn) {
          targetBtn.click();
          if (tabsWrapper) {
            var btnLeft = targetBtn.offsetLeft;
            var btnWidth = targetBtn.offsetWidth;
            var wrapperWidth = tabsWrapper.offsetWidth;
            var scrollPos = btnLeft - (wrapperWidth / 2) + (btnWidth / 2);
            tabsWrapper.scrollTo({ left: Math.max(0, scrollPos), behavior: 'smooth' });
          }
        }
      }

      if (tabPrevBtn) {
        tabPrevBtn.addEventListener('click', function() {
          var curr = getActiveTabIndex();
          if (curr > 0) {
            activateTabByIndex(curr - 1);
          }
        });
      }

      if (tabNextBtn) {
        tabNextBtn.addEventListener('click', function() {
          var curr = getActiveTabIndex();
          if (curr < tabButtons.length - 1) {
            activateTabByIndex(curr + 1);
          }
        });
      }

      // Tab Switching Handler
      tabButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var targetPanelId = this.getAttribute('data-tab-target');

          tabButtons.forEach(function(b) {
            b.classList.remove('is-active');
            b.setAttribute('aria-selected', 'false');
          });
          this.classList.add('is-active');
          this.setAttribute('aria-selected', 'true');

          panels.forEach(function(panel) {
            if (panel.id === targetPanelId) {
              panel.classList.add('is-active');
              setPanelPage(panel, 1, false);
            } else {
              panel.classList.remove('is-active');
            }
          });

          updateTabArrowStates();
        });
      });

      // Initialize tab arrows state
      updateTabArrowStates();

      // Pagination Click Handlers
      panels.forEach(function(panel) {
        var pagination = panel.querySelector('.deal-pagination');
        if (!pagination) return;

        var prevBtn = pagination.querySelector('.deal-pagination__prev');
        var nextBtn = pagination.querySelector('.deal-pagination__next');
        var pageBtns = pagination.querySelectorAll('.deal-pagination__page-btn');

        pageBtns.forEach(function(pBtn) {
          pBtn.addEventListener('click', function() {
            var targetPage = parseInt(this.getAttribute('data-page-target'), 10);
            setPanelPage(panel, targetPage, true);
          });
        });

        if (prevBtn) {
          prevBtn.addEventListener('click', function() {
            var curr = parseInt(panel.getAttribute('data-current-page') || '1', 10);
            if (curr > 1) {
              setPanelPage(panel, curr - 1, true);
            }
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', function() {
            var curr = parseInt(panel.getAttribute('data-current-page') || '1', 10);
            var total = parseInt(panel.getAttribute('data-total-pages') || '1', 10);
            if (curr < total) {
              setPanelPage(panel, curr + 1, true);
            }
          });
        }
      });

      function setPanelPage(panel, pageNum, doScroll) {
        panel.setAttribute('data-current-page', pageNum);
        var totalPages = parseInt(panel.getAttribute('data-total-pages') || '1', 10);

        // Update cards visibility
        var cards = panel.querySelectorAll('.deal-grid-card[data-page]');
        cards.forEach(function(card) {
          var cardPage = parseInt(card.getAttribute('data-page'), 10);
          if (cardPage === pageNum) {
            card.classList.add('is-page-visible');
          } else {
            card.classList.remove('is-page-visible');
          }
        });

        // Update pagination buttons state
        var pagination = panel.querySelector('.deal-pagination');
        if (pagination) {
          var prevBtn = pagination.querySelector('.deal-pagination__prev');
          var nextBtn = pagination.querySelector('.deal-pagination__next');
          var pageBtns = pagination.querySelectorAll('.deal-pagination__page-btn');

          if (prevBtn) {
            prevBtn.disabled = (pageNum <= 1);
            if (pageNum <= 1) {
              prevBtn.classList.add('is-disabled');
            } else {
              prevBtn.classList.remove('is-disabled');
            }
          }

          if (nextBtn) {
            nextBtn.disabled = (pageNum >= totalPages);
            if (pageNum >= totalPages) {
              nextBtn.classList.add('is-disabled');
            } else {
              nextBtn.classList.remove('is-disabled');
            }
          }

          pageBtns.forEach(function(btn) {
            var p = parseInt(btn.getAttribute('data-page-target'), 10);
            if (p === pageNum) {
              btn.classList.add('is-active');
              btn.setAttribute('aria-current', 'page');
            } else {
              btn.classList.remove('is-active');
              btn.removeAttribute('aria-current');
            }
          });
        }

        // Smooth scroll to top of section on user pagination click
        if (doScroll) {
          var header = sectionEl.querySelector('.product-grid__header');
          if (header) {
            header.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      }

      // Restore liked states on page load
      var wishlistButtons = sectionEl.querySelectorAll('.deal-grid-card__wishlist');
      wishlistButtons.forEach(function(btn) {
        var card = btn.closest('.deal-grid-card');
        if (card) {
          var id = card.getAttribute('data-product-id');
          if (id && localStorage.getItem('wishlist_' + id) === 'true') {
            btn.classList.add('is-active');
          }
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDealGrid);
    } else {
      initDealGrid();
    }
  })();
</script>

{% schema %}
{
  "name": "Featured Deals Grid",
  "tag": "section",
  "class": "section-product-grid-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Special Collection Deals"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated selection of handcrafted rugs and premium executive office furniture"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Default Collection"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 5,
      "max": 25,
      "step": 5,
      "default": 10,
      "label": "Products per page"
    },
    {
      "type": "checkbox",
      "id": "enable_pagination",
      "label": "Enable Pagination",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tab_arrows",
      "label": "Show Category Tab Arrows",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "collection_tab",
      "name": "Collection Tab",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Tab Title Override (Optional)"
        }
      ]
    },
    {
      "type": "product_card",
      "name": "Product Deal Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Product Title",
          "default": "Hand-Knotted Isfahan Wool & Silk Rug"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Sale Price",
          "default": "$899.00"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Deals Grid",
      "settings": {
        "heading": "Special Collection Deals",
        "subheading": "Curated selection of handcrafted rugs and premium executive office furniture",
        "products_per_page": 10,
        "enable_pagination": true
      },
      "blocks": [
        {
          "type": "collection_tab",
          "settings": {
            "collection": "special-collection",
            "title": "Special Collection"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "collection": "handmade-rugs",
            "title": "Handmade Rugs"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "collection": "4-x-6-rugs",
            "title": "4 x 6 Rugs"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "collection": "3x5-rug",
            "title": "3x5 Rugs"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "collection": "executive-desks",
            "title": "Executive Desks"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "collection": "office-chairs",
            "title": "Office Chairs"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "collection": "small-rugs",
            "title": "Small Rugs"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "collection": "storage",
            "title": "Storage"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "collection": "table",
            "title": "Tables"
          }
        }
      ]
    }
  ]
}
{% endschema %}
