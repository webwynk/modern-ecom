{% comment %}
  Compact Modern Luxury Contact Us Section
  SniMart E-Commerce
  Matches User Reference Design with SniMart Brand Guide Tokens (#997A51, DM Sans, #000000)
{% endcomment %}

{{ 'component-custom-contact.css' | asset_url | stylesheet_tag }}

<section class="custom-contact-section" id="CustomContact-{{ section.id }}" aria-label="{{ section.settings.heading | default: 'Contact Us' }}">
  <div class="custom-contact__container">
    <div class="custom-contact__grid">
      
      <!-- ========================================
           LEFT COLUMN: Information & Headings
           ======================================== -->
      <div class="custom-contact__info-col">
        
        <!-- Compact Pill Badge -->
        <div class="custom-contact__badge-wrap">
          <span class="custom-contact__badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="contact-badge__icon" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span>{{ section.settings.badge_text | default: 'Contact' }}</span>
          </span>
        </div>

        <!-- Big Bold Modern Heading -->
        <h1 class="custom-contact__title">
          {{ section.settings.heading | default: 'How can we help you today?' }}
        </h1>

        <!-- Subtitle -->
        <p class="custom-contact__subtitle">
          {{ section.settings.subheading | default: 'Our dedicated customer support team is just a message or call away.' }}
        </p>

        <!-- 3 Contact Channels with Rounded Squircles -->
        <div class="custom-contact__channels">
          
          <!-- Channel 1: Email -->
          {%- if section.settings.email != blank -%}
            <div class="contact-channel-row">
              <div class="contact-channel__squircle" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                </svg>
              </div>
              <div class="contact-channel__content">
                <div class="contact-channel__label">Email:</div>
                <a href="mailto:{{ section.settings.email }}" class="contact-channel__link">{{ section.settings.email }}</a>
              </div>
            </div>
          {%- endif -%}

          <!-- Channel 2: Phone -->
          {%- if section.settings.phone != blank -%}
            <div class="contact-channel-row">
              <div class="contact-channel__squircle" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                </svg>
              </div>
              <div class="contact-channel__content">
                <div class="contact-channel__label">Phone:</div>
                <a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}" class="contact-channel__link">{{ section.settings.phone }}</a>
              </div>
            </div>
          {%- endif -%}

          <!-- Channel 3: Location -->
          {%- if section.settings.address != blank -%}
            <div class="contact-channel-row">
              <div class="contact-channel__squircle" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
              </div>
              <div class="contact-channel__content">
                <div class="contact-channel__label">Location:</div>
                <div class="contact-channel__text">{{ section.settings.address }}</div>
              </div>
            </div>
          {%- endif -%}

        </div>

      </div>

      <!-- ========================================
           RIGHT COLUMN: Compact Form Card
           ======================================== -->
      <div class="custom-contact__form-col">
        <div class="custom-contact__card">
          
          {%- form 'contact', id: 'ContactFormCompact', class: 'contact-form-compact' -%}
            
            {%- if form.posted_successfully? -%}
              <div class="form-compact__alert form-compact__alert--success" role="status" tabindex="-1" autofocus>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                <span><strong>Thank you!</strong> Your message has been sent successfully. We will be in touch shortly.</span>
              </div>
            {%- elsif form.errors -%}
              <div class="form-compact__alert form-compact__alert--error" role="alert" tabindex="-1" autofocus>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="8" x2="12" y2="12"></line>
                  <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span><strong>Please check your submission:</strong> {{ form.errors | default_errors }}</span>
              </div>
            {%- endif -%}

            <!-- Row 1: First name & Last name -->
            <div class="form-compact__row form-compact__row--two-col">
              <div class="form-compact__field">
                <label for="ContactFirstName-{{ section.id }}" class="form-compact__label">First name*</label>
                <input 
                  type="text" 
                  id="ContactFirstName-{{ section.id }}" 
                  name="contact[first_name]" 
                  class="form-compact__input" 
                  placeholder="First name" 
                  required 
                  autocomplete="given-name"
                >
              </div>
              <div class="form-compact__field">
                <label for="ContactLastName-{{ section.id }}" class="form-compact__label">Last name*</label>
                <input 
                  type="text" 
                  id="ContactLastName-{{ section.id }}" 
                  name="contact[last_name]" 
                  class="form-compact__input" 
                  placeholder="Last name" 
                  required 
                  autocomplete="family-name"
                >
              </div>
            </div>

            <!-- Row 2: Work email -->
            <div class="form-compact__row">
              <div class="form-compact__field">
                <label for="ContactEmail-{{ section.id }}" class="form-compact__label">Work email*</label>
                <input 
                  type="email" 
                  id="ContactEmail-{{ section.id }}" 
                  name="contact[email]" 
                  class="form-compact__input" 
                  placeholder="Enter email" 
                  required 
                  autocomplete="email"
                  spellcheck="false" 
                  autocapitalize="off"
                >
              </div>
            </div>

            <!-- Row 3: Phone number with country prefix -->
            <div class="form-compact__row">
              <div class="form-compact__field">
                <label for="ContactPhone-{{ section.id }}" class="form-compact__label">Phone number*</label>
                <div class="form-compact__phone-wrap">
                  <div class="form-compact__phone-prefix" aria-hidden="true">
                    <span class="phone-prefix__flag">🇺🇸</span>
                    <span class="phone-prefix__code">+1</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="phone-prefix__chevron">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </div>
                  <input 
                    type="tel" 
                    id="ContactPhone-{{ section.id }}" 
                    name="contact[phone]" 
                    class="form-compact__phone-input" 
                    placeholder="Enter phone number" 
                    required 
                    autocomplete="tel"
                  >
                </div>
              </div>
            </div>

            <!-- Row 4: Message -->
            <div class="form-compact__row">
              <div class="form-compact__field">
                <label for="ContactMessage-{{ section.id }}" class="form-compact__label">Message*</label>
                <textarea 
                  id="ContactMessage-{{ section.id }}" 
                  name="contact[body]" 
                  class="form-compact__textarea" 
                  placeholder="Enter a question, feedback, or suggestions..." 
                  rows="4" 
                  required
                ></textarea>
              </div>
            </div>

            <!-- Row 5: Submit Button -->
            <div class="form-compact__submit-wrap">
              <button type="submit" class="form-compact__submit-btn">
                <span>Submit</span>
              </button>
            </div>

          {%- endform -%}

        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Contact Us",
  "tag": "section",
  "class": "section-custom-contact-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "How can we help you today?"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtitle",
      "default": "Our dedicated customer support team is just a message or call away."
    },
    {
      "type": "header",
      "content": "Contact Details"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "support@snimart.com"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "+1 (888) 795-8816"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Location Address",
      "default": "11373 Trade Center Dr, Suite 245, Rancho Cordova, CA 95742, USA"
    }
  ],
  "presets": [
    {
      "name": "Custom Contact Us"
    }
  ]
}
{% endschema %}
