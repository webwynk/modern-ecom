  <!-- ========================================
       TIER 4: Bottom Copyright & Payments Bar
       ======================================== -->
  <div class="footer-bottom-bar">
    <div class="custom-footer__container">
      <div class="footer-bottom-flex">
        
        <!-- Left: Copyright -->
        <p class="footer-copyright-text">
          Copyright &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_name | default: 'The Golden Rug & Furniture Co.' }}. All Rights Reserved.
        </p>

        <!-- Right: Payment Badges SVG -->
        <div class="footer-payments-list">
          <img 
            src="{{ 'payments.svg' | asset_url }}" 
            alt="Accepted Payment Methods: Visa, Diners, Amex, Discover, Mastercard, Stripe, PayPal, GPay, Apple Pay" 
            class="footer-payments-svg" 
            width="379" 
            height="24" 
            loading="lazy"
          >
        </div>

      </div>
    </div>
  </div>

  <!-- Floating Scroll To Top Button -->
  <a href="#top" class="footer-scroll-top-btn" id="footerScrollTop" aria-label="Scroll to top">
    <svg viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"/></svg>
    <span class="footer-scroll-top-text">Top</span>
  </a>

</footer>

<script>
  (function() {
    var scrollBtn = document.getElementById('footerScrollTop');
    if (scrollBtn) {
      scrollBtn.addEventListener('click', function(e) {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      window.addEventListener('scroll', function() {
        if (window.pageYOffset > 400) {
          scrollBtn.style.opacity = '1';
          scrollBtn.style.visibility = 'visible';
        } else {
          scrollBtn.style.opacity = '0';
          scrollBtn.style.visibility = 'hidden';
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Custom Luxury Footer",
  "tag": "section",
  "class": "section-custom-footer-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "The Golden Rug"
    },
    {
      "type": "text",
      "id": "trustpilot_text",
      "label": "Trustpilot Rating Subtext",
      "default": "TrustScore 4.9 | 9,000+ Reviews"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Support Phone Number",
      "default": "(213) 555-1234"
    },
    {
      "type": "text",
      "id": "phone_hours",
      "label": "Working Hours",
      "default": "Mon - Fri: 09:00am - 18:00pm EST"
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "Copyright Brand Name",
      "default": "The Golden Rug & Furniture Co."
    },
    {
      "type": "header",
      "content": "Trust Badges"
    },
    {
      "type": "text",
      "id": "trust_1_text",
      "label": "Badge 1 Text",
      "default": "Free Worldwide Insured Shipping"
    },
    {
      "type": "text",
      "id": "trust_2_text",
      "label": "Badge 2 Text",
      "default": "Dedicated Artisan Concierge"
    },
    {
      "type": "text",
      "id": "trust_3_text",
      "label": "Badge 3 Text",
      "default": "100% Certificate of Authenticity"
    },
    {
      "type": "text",
      "id": "trust_4_text",
      "label": "Badge 4 Text",
      "default": "Over 9,000 Verified 5-Star Reviews"
    }
  ],
  "presets": [
    {
      "name": "Custom Luxury Footer"
    }
  ]
}
{% endschema %}
