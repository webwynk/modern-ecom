{% schema %}
{
  "name": "Top Brands Animated",
  "tag": "section",
  "class": "section-brand-logos-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Top Brands"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Trusted by industry leaders and global enterprise partners"
    }
  ],
  "presets": [
    {
      "name": "Top Brands Animated"
    }
  ]
}
{% endschema %}
