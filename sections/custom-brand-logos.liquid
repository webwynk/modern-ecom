          <a href="/collections/all" class="brand-logo-card"><img src="{{ 'BOARDWALK_LOGO-140x140-0.jpg' | asset_url }}" alt="Boardwalk" loading="lazy"></a>
          <a href="/collections/all" class="brand-logo-card"><img src="{{ 'KLEENEX_LOGO-140x140-0.jpg' | asset_url }}" alt="Kleenex" loading="lazy"></a>
          <a href="/collections/all" class="brand-logo-card"><img src="{{ 'WYPALL_1_LOGO-140x140-0.jpg' | asset_url }}" alt="WypAll" loading="lazy"></a>
          <a href="/collections/all" class="brand-logo-card"><img src="{{ 'PURELL_LOGO-140x140-0.jpg' | asset_url }}" alt="Purell" loading="lazy"></a>
