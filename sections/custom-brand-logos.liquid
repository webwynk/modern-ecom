{% comment %}
  Custom Top Brands Dual-Row Animated Marquee Section
  - Row 1: 10 logos scrolling smoothly to the RIGHT
  - Row 2: 10 logos scrolling smoothly to the LEFT
  - Interactive hover pause
{% endcomment %}

{{ 'component-brand-logos.css' | asset_url | stylesheet_tag }}

<div class="section-brand-logos" id="BrandLogos-{{ section.id }}">
  <div class="brand-logos__container">
    
    <div class="brand-logos__header">
      <div class="brand-logos__title-group">
        <h2 class="brand-logos__heading">{{ section.settings.heading | default: 'Top Brands' }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="brand-logos__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    </div>

    <div class="brand-marquee-wrapper">
      
      <!-- ========================================
           ROW 1: Auto Smooth Animation to the RIGHT
           ======================================== -->
      <div class="brand-marquee-row brand-marquee-row--right" aria-label="Brands Carousel Row 1">
        <div class="brand-marquee-track">
          <!-- Set 1 -->
          <a href="/collections/all" class="brand-logo-card"><img src="{{ '232-140x140-0.jpg' | asset_url }}" alt="HP" loading="lazy"></a>
          <a href="/collections/all" class="brand-logo-card"><img src="{{ 'TORK_LOGO-140x140-0.jpg' | asset_url }}" alt="Tork" loading="lazy"></a>
