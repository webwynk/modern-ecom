<script>
  (function() {
    function initHeaderScripts() {
      // Mobile Cart Drawer Trigger & Sync
      var mobileCartBtn = document.querySelector('#cart-icon-bubble-mobile');
      var desktopCartBubble = document.querySelector('#cart-icon-bubble');

      if (mobileCartBtn) {
        mobileCartBtn.setAttribute('role', 'button');
        mobileCartBtn.setAttribute('aria-haspopup', 'dialog');
        mobileCartBtn.addEventListener('click', function(e) {
          var cartDrawer = document.querySelector('cart-drawer');
          if (cartDrawer && typeof cartDrawer.open === 'function') {
            e.preventDefault();
            cartDrawer.open(mobileCartBtn);
          }
        });
      }

      if (desktopCartBubble) {
        desktopCartBubble.setAttribute('role', 'button');
        desktopCartBubble.setAttribute('aria-haspopup', 'dialog');
        desktopCartBubble.addEventListener('click', function(e) {
          var cartDrawer = document.querySelector('cart-drawer');
          if (cartDrawer && typeof cartDrawer.open === 'function') {
            e.preventDefault();
            cartDrawer.open(desktopCartBubble);
          }
        });
      }

      if (desktopCartBubble && mobileCartBtn) {
        var syncCartCount = function() {
          var desktopCountEl = desktopCartBubble.querySelector('.header-nav__cart-count');
          var mobileCountEl = mobileCartBtn.querySelector('.header-mobile__cart-count');
          if (desktopCountEl && mobileCountEl) {
            mobileCountEl.textContent = desktopCountEl.textContent.trim();
          }
        };

        var observer = new MutationObserver(syncCartCount);
        observer.observe(desktopCartBubble, { childList: true, subtree: true, characterData: true });
      }

      // Compact Search Drawer Modal Controller
      var modal = document.getElementById('SearchDrawerModal');
      if (modal) {
        var input = document.getElementById('Search-In-Modal');
        var resetBtn = modal.querySelector('.search-drawer-modal__reset-btn');
        var popularTags = document.getElementById('SearchDrawerPopularTags');
        var openTriggers = document.querySelectorAll('[data-open-search-modal]');
        var closeTriggers = modal.querySelectorAll('.search-drawer-modal__overlay, .search-drawer-modal__close-btn');

        function openModal() {
          modal.classList.add('is-active');
          modal.setAttribute('aria-hidden', 'false');
          document.body.classList.add('overflow-hidden');
          setTimeout(function() {
            if (input) input.focus();
          }, 60);
        }

        function closeModal() {
          modal.classList.remove('is-active');
          modal.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('overflow-hidden');
        }

        openTriggers.forEach(function(btn) {
          btn.addEventListener('click', function(e) {
            e.preventDefault();
            openModal();
          });
        });

        closeTriggers.forEach(function(btn) {
          btn.addEventListener('click', function(e) {
            e.preventDefault();
            closeModal();
          });
        });

        // ESC key & ⌘K / Ctrl+K
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && modal.classList.contains('is-active')) {
            closeModal();
          }
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
            if (window.innerWidth < 990) {
              e.preventDefault();
              modal.classList.contains('is-active') ? closeModal() : openModal();
            }
          }
        });

        // Input & Reset logic
        if (input && resetBtn) {
          input.addEventListener('input', function() {
            resetBtn.style.display = this.value.length > 0 ? 'inline-flex' : 'none';
            if (popularTags) {
              popularTags.style.display = this.value.length > 0 ? 'none' : 'block';
            }
          });

          resetBtn.addEventListener('click', function() {
            input.value = '';
            resetBtn.style.display = 'none';
            if (popularTags) popularTags.style.display = 'block';
            input.focus();
            var predictiveContainer = modal.querySelector('[data-predictive-search]');
            if (predictiveContainer) predictiveContainer.innerHTML = '';
          });
        }

        // Category / Quick Tags Click
        modal.querySelectorAll('.search-drawer-modal__tag').forEach(function(tag) {
          tag.addEventListener('click', function() {
            var text = this.getAttribute('data-search-tag');
            if (text && input) {
              input.value = text;
              input.dispatchEvent(new Event('input', { bubbles: true }));
              input.focus();
            } else {
              closeModal();
            }
          });
        });
      }

      // Desktop Search Bar & Dropdown Controller (No Extra Modal on Desktop)
      var desktopSearchWrapper = document.querySelector('.header-main__search');
      if (desktopSearchWrapper) {
        var desktopInput = desktopSearchWrapper.querySelector('.header-search__input');
        var desktopDropdown = desktopSearchWrapper.querySelector('#HeaderSearchDropdown');
        var desktopCategories = desktopSearchWrapper.querySelector('#HeaderSearchPopularCategories');
        var desktopResetBtn = desktopSearchWrapper.querySelector('.header-search__reset-btn');

        function openDesktopDropdown() {
          if (desktopDropdown) {
            desktopDropdown.style.display = 'block';
            if (desktopCategories) {
              desktopCategories.style.display = (desktopInput && desktopInput.value.trim().length > 0) ? 'none' : 'block';
            }
          }
        }

        function closeDesktopDropdown() {
          if (desktopDropdown) {
            desktopDropdown.style.display = 'none';
          }
        }

        if (desktopInput) {
          // Clicking anywhere in the search bar container (icon, border, form area) opens the dropdown
          desktopSearchWrapper.addEventListener('click', function(e) {
            // Don't hijack clicks on category tag links inside the dropdown
            if (!e.target.closest('a, button')) {
              desktopInput.focus();
            }
          });

          desktopInput.addEventListener('focus', openDesktopDropdown);
          desktopInput.addEventListener('click', openDesktopDropdown);

          desktopInput.addEventListener('input', function() {
            if (desktopResetBtn) {
              desktopResetBtn.style.display = this.value.length > 0 ? 'inline-flex' : 'none';
            }
            if (desktopCategories) {
              desktopCategories.style.display = this.value.trim().length > 0 ? 'none' : 'block';
            }
            if (desktopDropdown) {
              desktopDropdown.style.display = 'block';
            }
          });

          // Ensure predictive results appearing keep dropdown open and categories hidden
          var predictiveSearchEl = desktopSearchWrapper.querySelector('predictive-search');
          if (predictiveSearchEl) {
            var searchObserver = new MutationObserver(function() {
              if (predictiveSearchEl.hasAttribute('open') || predictiveSearchEl.hasAttribute('results')) {
                if (desktopDropdown) desktopDropdown.style.display = 'block';
                if (desktopCategories) desktopCategories.style.display = 'none';
              }
            });
            searchObserver.observe(predictiveSearchEl, { attributes: true, attributeFilter: ['open', 'results', 'loading'] });
          }

          if (desktopResetBtn) {
            desktopResetBtn.addEventListener('click', function() {
              desktopInput.value = '';
              desktopResetBtn.style.display = 'none';
              if (desktopCategories) desktopCategories.style.display = 'block';
              desktopInput.focus();
              var predictiveResults = desktopSearchWrapper.querySelector('[data-predictive-search]');
              if (predictiveResults) predictiveResults.innerHTML = '';
            });
          }
        }

        // Close on click outside
        document.addEventListener('click', function(e) {
          if (desktopSearchWrapper && !desktopSearchWrapper.contains(e.target)) {
            closeDesktopDropdown();
          }
        });

        // Close on Escape, focus on ⌘K / Ctrl+K
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && desktopDropdown && desktopDropdown.style.display === 'block') {
            closeDesktopDropdown();
            if (desktopInput) desktopInput.blur();
          }
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
            if (window.innerWidth >= 990 && desktopInput) {
              e.preventDefault();
              desktopInput.focus();
              openDesktopDropdown();
            }
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeaderScripts);
    } else {
      initHeaderScripts();
    }
  })();
</script>

{%- if settings.cart_type == 'notification' -%}
