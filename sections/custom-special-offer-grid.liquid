{% comment %}
  Custom Special Offer Deal & Tabbed Product Grid Section
  - Left: Featured Special Offer Box with Brand Gold border & Live Countdown Timer
  - Right: Tabbed Product Grid (Featured / On Sale / Top Rated) with 8 products
{% endcomment %}

{{ 'component-special-offer-grid.css' | asset_url | stylesheet_tag }}

<div class="section-special-offer-grid" id="SpecialOffer-{{ section.id }}">
  <div class="special-offer-grid__container">
    <div class="special-offer-grid__layout">
      
      <!-- ========================================
           1. Left Column: Special Offer Box
           ======================================== -->
      {%- liquid
        assign offer_prod = section.settings.offer_product
        if offer_prod == blank and section.settings.offer_product != blank
          assign offer_prod = all_products[section.settings.offer_product]
        endif
        if offer_prod == blank
          assign offer_prod = collections['all'].products.first
        endif
      -%}
      {%- assign offer_url = section.settings.offer_link -%}
      {%- if offer_url == blank and offer_prod != blank -%}
        {%- assign offer_url = offer_prod.url -%}
      {%- endif -%}
      {%- if offer_url == blank -%}
        {%- assign offer_url = '/collections/all' -%}
      {%- endif -%}

      {%- assign offer_title = section.settings.offer_title -%}
      {%- if offer_prod != blank -%}
        {%- assign offer_title = offer_prod.title -%}
      {%- endif -%}
      {%- if offer_title == blank -%}
        {%- assign offer_title = 'Special Spotlight Deal' -%}
      {%- endif -%}

      {%- assign offer_price_str = section.settings.offer_price -%}
      {%- if offer_prod != blank -%}
        {%- assign offer_price_str = offer_prod.price | money -%}
      {%- endif -%}

      {%- assign offer_old_price_str = section.settings.offer_old_price -%}
      {%- if offer_prod != blank and offer_prod.compare_at_price > offer_prod.price -%}
        {%- assign offer_old_price_str = offer_prod.compare_at_price | money -%}
      {%- endif -%}

      <a href="{{ offer_url }}" class="special-offer-card">
        <div>
          <div class="special-offer-card__header">
            <h3 class="special-offer-card__title-label">{{ section.settings.offer_label | default: 'Special Offer' }}</h3>
            <div class="special-offer-card__badge">
              <span>Save</span>
              <span>
                {%- if offer_prod != blank and offer_prod.compare_at_price > offer_prod.price -%}
                  {{ offer_prod.compare_at_price | minus: offer_prod.price | money }}
                {%- elsif section.settings.offer_save_amount != blank -%}
                  {{ section.settings.offer_save_amount }}
                {%- else -%}
                  DEAL
                {%- endif -%}
              </span>
            </div>
          </div>

          <div class="special-offer-card__media">
            {% if section.settings.offer_image != blank %}
              <img src="{{ section.settings.offer_image | image_url: width: 500 }}" alt="{{ offer_title | escape }}" loading="lazy">
            {% elsif offer_prod != blank and offer_prod.featured_media != blank %}
              <img src="{{ offer_prod.featured_media | image_url: width: 500 }}" alt="{{ offer_title | escape }}" loading="lazy">
            {% elsif offer_prod != blank and offer_prod.featured_image != blank %}
              <img src="{{ offer_prod.featured_image | image_url: width: 500 }}" alt="{{ offer_title | escape }}" loading="lazy">
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>

          <div class="special-offer-card__info">
            <h4 class="special-offer-card__title">{{ offer_title }}</h4>
            <div class="special-offer-card__pricing">
              {% if offer_price_str != blank %}
                <span class="special-offer-card__price">{{ offer_price_str }}</span>
              {% endif %}
              {% if offer_old_price_str != blank %}
                <span class="special-offer-card__old-price">{{ offer_old_price_str }}</span>
              {% endif %}
            </div>
          </div>
        </div>

        <!-- Countdown Timer -->
        <div class="special-offer-timer">
          <span class="timer-title">Hurry up! Offer ends in:</span>
          <div class="timer-countdown" id="specialOfferTimer-{{ section.id }}">
            <div class="timer-block">
              <span class="timer-number timer-hours">08</span>
              <span class="timer-label">Hours</span>
            </div>
            <span class="timer-separator">:</span>
            <div class="timer-block">
              <span class="timer-number timer-minutes">42</span>
              <span class="timer-label">Mins</span>
            </div>
            <span class="timer-separator">:</span>
            <div class="timer-block">
              <span class="timer-number timer-seconds">15</span>
              <span class="timer-label">Secs</span>
            </div>
          </div>
        </div>
      </a>

      <!-- ========================================
           2. Right Column: Tabbed Product Grid
           ======================================== -->
      <div class="special-offer-grid__content">
        <!-- Interactive Tab Navigation -->
        <div class="special-offer-tabs" role="tablist">
          <button type="button" class="tab-btn is-active" data-tab="tab-featured-{{ section.id }}" role="tab" aria-selected="true">Featured</button>
          <button type="button" class="tab-btn" data-tab="tab-onsale-{{ section.id }}" role="tab" aria-selected="false">On Sale</button>
          <button type="button" class="tab-btn" data-tab="tab-toprated-{{ section.id }}" role="tab" aria-selected="false">Top Rated</button>
        </div>

        <!-- Tab 1: Featured Products Grid -->
        <div class="tab-content is-active" id="tab-featured-{{ section.id }}" role="tabpanel">
          {%- liquid
            assign col_featured = section.settings.collection_featured
            if col_featured.title == blank and section.settings.collection_featured != blank
              assign col_featured = collections[section.settings.collection_featured]
            endif
            if col_featured == blank or col_featured.all_products_count == 0
              assign col_featured = collections['all']
            endif
          -%}
          {%- if col_featured != blank and col_featured.products.size > 0 -%}
            {%- for product in col_featured.products limit: 8 -%}
              <a href="{{ product.url }}" class="grid-product-card">
                <span class="grid-product-card__category">{{ product.type | default: col_featured.title }}</span>
                <h4 class="grid-product-card__title">{{ product.title }}</h4>
                <div class="grid-product-card__media">
                  {%- if product.featured_media != blank -%}
                    <img src="{{ product.featured_media | image_url: width: 300 }}" alt="{{ product.title | escape }}" loading="lazy">
                  {%- elsif product.featured_image != blank -%}
                    <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title | escape }}" loading="lazy">
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </div>
                <div class="grid-product-card__footer">
                  <div class="grid-product-card__pricing">
                    <span class="grid-product-card__price {% if product.compare_at_price > product.price %}grid-product-card__price--sale{% endif %}">{{ product.price | money }}</span>
                    {%- if product.compare_at_price > product.price -%}
                      <span class="grid-product-card__old-price">{{ product.compare_at_price | money }}</span>
                    {%- endif -%}
                  </div>
                  <button type="button" class="grid-product-card__cart-btn" aria-label="View product">
                    <svg viewBox="0 0 24 24"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg>
                  </button>
                </div>
              </a>
            {%- endfor -%}
          {%- else -%}
            <div class="special-offer-tab__empty">
              <p>No products found in this collection.</p>
            </div>
          {%- endif -%}
        </div>

        <!-- Tab 2: On Sale Grid -->
        <div class="tab-content" id="tab-onsale-{{ section.id }}" role="tabpanel">
          {%- liquid
            assign col_onsale = section.settings.collection_onsale
            if col_onsale.title == blank and section.settings.collection_onsale != blank
              assign col_onsale = collections[section.settings.collection_onsale]
            endif
            if col_onsale == blank or col_onsale.all_products_count == 0
              assign col_onsale = collections['all']
            endif
          -%}
          {%- if col_onsale != blank and col_onsale.products.size > 0 -%}
            {%- for product in col_onsale.products limit: 8 -%}
              <a href="{{ product.url }}" class="grid-product-card">
                <span class="grid-product-card__category">{{ product.type | default: col_onsale.title }}</span>
                <h4 class="grid-product-card__title">{{ product.title }}</h4>
                <div class="grid-product-card__media">
                  {%- if product.featured_media != blank -%}
                    <img src="{{ product.featured_media | image_url: width: 300 }}" alt="{{ product.title | escape }}" loading="lazy">
                  {%- elsif product.featured_image != blank -%}
                    <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title | escape }}" loading="lazy">
                  {%- else -%}
                    {{ 'product-2' | placeholder_svg_tag }}
                  {%- endif -%}
                </div>
                <div class="grid-product-card__footer">
                  <div class="grid-product-card__pricing">
                    <span class="grid-product-card__price grid-product-card__price--sale">{{ product.price | money }}</span>
                    {%- if product.compare_at_price > product.price -%}
                      <span class="grid-product-card__old-price">{{ product.compare_at_price | money }}</span>
                    {%- endif -%}
                  </div>
                  <button type="button" class="grid-product-card__cart-btn" aria-label="View product">
                    <svg viewBox="0 0 24 24"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg>
                  </button>
                </div>
              </a>
            {%- endfor -%}
          {%- else -%}
            <div class="special-offer-tab__empty">
              <p>No products found in this collection.</p>
            </div>
          {%- endif -%}
        </div>

        <!-- Tab 3: Top Rated Grid -->
        <div class="tab-content" id="tab-toprated-{{ section.id }}" role="tabpanel">
          {%- liquid
            assign col_toprated = section.settings.collection_toprated
            if col_toprated.title == blank and section.settings.collection_toprated != blank
              assign col_toprated = collections[section.settings.collection_toprated]
            endif
            if col_toprated == blank or col_toprated.all_products_count == 0
              assign col_toprated = collections['all']
            endif
          -%}
          {%- if col_toprated != blank and col_toprated.products.size > 0 -%}
            {%- for product in col_toprated.products limit: 8 -%}
              <a href="{{ product.url }}" class="grid-product-card">
                <span class="grid-product-card__category">{{ product.type | default: col_toprated.title }}</span>
                <h4 class="grid-product-card__title">{{ product.title }}</h4>
                <div class="grid-product-card__media">
                  {%- if product.featured_media != blank -%}
                    <img src="{{ product.featured_media | image_url: width: 300 }}" alt="{{ product.title | escape }}" loading="lazy">
                  {%- elsif product.featured_image != blank -%}
                    <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title | escape }}" loading="lazy">
                  {%- else -%}
                    {{ 'product-3' | placeholder_svg_tag }}
                  {%- endif -%}
                </div>
                <div class="grid-product-card__footer">
                  <div class="grid-product-card__pricing">
                    <span class="grid-product-card__price {% if product.compare_at_price > product.price %}grid-product-card__price--sale{% endif %}">{{ product.price | money }}</span>
                    {%- if product.compare_at_price > product.price -%}
                      <span class="grid-product-card__old-price">{{ product.compare_at_price | money }}</span>
                    {%- endif -%}
                  </div>
                  <button type="button" class="grid-product-card__cart-btn" aria-label="View product">
                    <svg viewBox="0 0 24 24"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg>
                  </button>
                </div>
              </a>
            {%- endfor -%}
          {%- else -%}
            <div class="special-offer-tab__empty">
              <p>No products found in this collection.</p>
            </div>
          {%- endif -%}
        </div>

      </div>

    </div>
  </div>
</div>

<script>
  (function() {
    // 1. Tab Switching Logic
    var section = document.getElementById('SpecialOffer-{{ section.id }}');
    if (section) {
      var tabButtons = section.querySelectorAll('.tab-btn');
      var tabContents = section.querySelectorAll('.tab-content');

      tabButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          tabButtons.forEach(function(b) {
            b.classList.remove('is-active');
            b.setAttribute('aria-selected', 'false');
          });
          tabContents.forEach(function(c) {
            c.classList.remove('is-active');
          });

          btn.classList.add('is-active');
          btn.setAttribute('aria-selected', 'true');
          var targetId = btn.getAttribute('data-tab');
          var targetContent = document.getElementById(targetId);
          if (targetContent) {
            targetContent.classList.add('is-active');
          }
        });
      });

      // 2. Real-Time Countdown Timer Logic
      var timerContainer = document.getElementById('offerTimer-{{ section.id }}');
      if (timerContainer) {
        var hoursElem = timerContainer.querySelector('.timer-hours');
        var minsElem = timerContainer.querySelector('.timer-minutes');
        var secsElem = timerContainer.querySelector('.timer-seconds');

        var totalSeconds = 8 * 3600 + 42 * 60 + 15; // 8 hours 42 mins 15 secs
        var countdown = setInterval(function() {
          if (totalSeconds <= 0) {
            totalSeconds = 12 * 3600; // loop
          } else {
            totalSeconds--;
          }

          var h = Math.floor(totalSeconds / 3600);
          var m = Math.floor((totalSeconds % 3600) / 60);
          var s = totalSeconds % 60;

          if (hoursElem) hoursElem.textContent = (h < 10 ? '0' : '') + h;
          if (minsElem) minsElem.textContent = (m < 10 ? '0' : '') + m;
          if (secsElem) secsElem.textContent = (s < 10 ? '0' : '') + s;
        }, 1000);
      }
    }
  })();
</script>

{% schema %}
{
  "name": "Special Offer & Tab Grid",
  "tag": "section",
  "class": "section-special-offer-grid-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Special Offer Box (Left)"
    },
    {
      "type": "product",
      "id": "offer_product",
      "label": "Offer Product (Auto-populates title, price & image)"
    },
    {
      "type": "text",
      "id": "offer_label",
      "label": "Offer Label",
      "default": "Special Offer"
    },
    {
      "type": "text",
      "id": "offer_save_amount",
      "label": "Save Amount Badge",
      "default": "$400"
    },
    {
      "type": "text",
      "id": "offer_title",
      "label": "Offer Product Title (Fallback if no product chosen)",
      "default": "Special Spotlight Deal"
    },
    {
      "type": "text",
      "id": "offer_price",
      "label": "Sale Price (Fallback)"
    },
    {
      "type": "text",
      "id": "offer_old_price",
      "label": "Old Price (Fallback)"
    },
    {
      "type": "url",
      "id": "offer_link",
      "label": "Offer Link (Fallback)"
    },
    {
      "type": "image_picker",
      "id": "offer_image",
      "label": "Offer Product Image (Fallback)"
    },
    {
      "type": "header",
      "content": "Tabbed Product Collections (Right)"
    },
    {
      "type": "collection",
      "id": "collection_featured",
      "label": "Featured Tab Collection"
    },
    {
      "type": "collection",
      "id": "collection_onsale",
      "label": "On Sale Tab Collection"
    },
    {
      "type": "collection",
      "id": "collection_toprated",
      "label": "Top Rated Tab Collection"
    }
  ],
  "presets": [
    {
      "name": "Special Offer & Tab Grid"
    }
  ]
}
{% endschema %}
