{% comment %}
  Modern Site Preloader Overlay
  Features:
    - User-specified 8-step radial multi-dot loader in brand highlight #997A51
    - Guaranteed minimum 1000ms (1 full second) display duration so animation is always seen on reload
    - Explicit #997A51 shadow colors for bulletproof rendering across all browsers
    - Clean white #FFFFFF backdrop
    - Butter-smooth fade-out with safety timeout
{% endcomment %}

<style>
  .modern-preloader {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999999;
    opacity: 1;
    visibility: visible;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .modern-preloader.preloader--hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .modern-preloader .loader {
    --d: 22px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    color: #997A51;
    box-shadow: 
      calc(1*var(--d))      calc(0*var(--d))     0 0   #997A51,
      calc(0.707*var(--d))  calc(0.707*var(--d)) 0 1px #997A51,
      calc(0*var(--d))      calc(1*var(--d))     0 2px #997A51,
      calc(-0.707*var(--d)) calc(0.707*var(--d)) 0 3px #997A51,
      calc(-1*var(--d))     calc(0*var(--d))     0 4px #997A51,
      calc(-0.707*var(--d)) calc(-0.707*var(--d))0 5px #997A51,
      calc(0*var(--d))      calc(-1*var(--d))    0 6px #997A51;
    animation: l27 1s infinite steps(8);
  }

  @keyframes l27 {
    100% { transform: rotate(1turn); }
  }

  @media (prefers-reduced-motion: reduce) {
    .modern-preloader .loader {
      animation-duration: 2s;
    }
  }
</style>

<div class="modern-preloader" id="ModernPreloader" aria-hidden="true">
  <div class="loader"></div>
</div>

<script>
  (function() {
    var preloader = document.getElementById('ModernPreloader');
    if (!preloader) return;

    var startTime = Date.now();
    var minDuration = 1000; // Guaranteed minimum 1000ms display time so full 1s cycle is seen
    var dismissed = false;

    function dismiss() {
      if (dismissed) return;
      dismissed = true;
      preloader.classList.add('preloader--hidden');
      setTimeout(function() {
        if (preloader && preloader.parentNode) {
          preloader.parentNode.removeChild(preloader);
        }
      }, 450);
    }

    function scheduleDismiss() {
      var elapsed = Date.now() - startTime;
      var remaining = Math.max(0, minDuration - elapsed);
      setTimeout(dismiss, remaining);
    }

    if (document.readyState === 'complete') {
      scheduleDismiss();
    } else {
      window.addEventListener('load', scheduleDismiss);
      // Safety fallback: dismiss after 2.5s so user is never blocked
      setTimeout(scheduleDismiss, 2500);
    }
  })();
</script>
