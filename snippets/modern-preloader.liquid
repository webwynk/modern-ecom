{%- unless request.design_mode -%}
{% comment %}
  Modern Luxury Site Preloader Overlay
  Brand: The Golden Rug (#997A51)
  Features:
    - High-performance, razor-sharp SVG vector 8-step radial multi-dot loader in brand highlight #997A51
    - Luxury brand title "THE GOLDEN RUG" in DM Sans 600 with letter-spacing 0.18em
    - Clean white #FFFFFF backdrop
    - Smooth 800ms minimum display floor with seamless dissolve fade-out
    - 100% cross-browser reliability (GPU-accelerated vector rotation)
    - Fully accessible with aria-hidden="true" and reduced motion support
{% endcomment %}

<style>
  .modern-preloader {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999999;
    opacity: 1;
    visibility: visible;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .modern-preloader.preloader--hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .modern-preloader__wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.8rem;
  }

  .modern-preloader__spinner {
    width: 46px;
    height: 46px;
    animation: modern-preloader-spin 1s infinite steps(8);
    transform-origin: center center;
    display: block;
  }

  @keyframes modern-preloader-spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  .modern-preloader__title {
    font-family: var(--font-heading-family, 'DM Sans', sans-serif);
    font-size: 1.8rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #000000;
    margin: 0;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .modern-preloader__title {
      font-size: 2.0rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .modern-preloader__spinner {
      animation-duration: 2s;
    }
  }
</style>

<div class="modern-preloader" id="ModernPreloader" aria-hidden="true">
  <div class="modern-preloader__wrapper">
    <svg class="modern-preloader__spinner" viewBox="0 0 50 50" fill="#997A51" xmlns="http://www.w3.org/2000/svg" role="presentation">
      <!-- 7 graduated radial dots with 8th position empty, creating the iconic stepping loader -->
      <circle cx="43" cy="25" r="1.75" />
      <circle cx="37.7" cy="37.7" r="2.25" />
      <circle cx="25" cy="43" r="2.75" />
      <circle cx="12.3" cy="37.7" r="3.25" />
      <circle cx="7" cy="25" r="3.75" />
      <circle cx="12.3" cy="12.3" r="4.25" />
      <circle cx="25" cy="7" r="4.75" />
    </svg>
    <span class="modern-preloader__title">The Golden Rug</span>
  </div>
</div>

<script>
  (function() {
    var preloader = document.getElementById('ModernPreloader');
    if (!preloader) return;

    var startTime = Date.now();
    var minDuration = 800; // 800ms display floor so a full, crisp animation cycle is visible
    var dismissed = false;

    function dismiss() {
      if (dismissed) return;
      dismissed = true;
      preloader.classList.add('preloader--hidden');
      setTimeout(function() {
        if (preloader && preloader.parentNode) {
          preloader.parentNode.removeChild(preloader);
        }
      }, 450);
    }

    function scheduleDismiss() {
      var elapsed = Date.now() - startTime;
      var remaining = Math.max(0, minDuration - elapsed);
      setTimeout(dismiss, remaining);
    }

    if (document.readyState === 'interactive' || document.readyState === 'complete') {
      scheduleDismiss();
    } else {
      document.addEventListener('DOMContentLoaded', scheduleDismiss);
      window.addEventListener('load', scheduleDismiss);
      // Hard fallback after 2s so user is never stuck
      setTimeout(scheduleDismiss, 2000);
    }
  })();
</script>
{%- endunless -%}
