{% comment %}
  Modern Site Preloader Overlay
  Features:
    - Prominent 8-step radial multi-dot loader in brand highlight #997A51 (scaled to 8px dots, --d: 35px)
    - Luxury brand title "The Golden Rug" in DM Sans 600 with letter-spacing 0.18em
    - Clean white #FFFFFF backdrop
    - Guaranteed 1000ms minimum display duration so the animation is clearly visible on every reload
    - Butter-smooth fade-out transition
{% endcomment %}

<style>
  .modern-preloader {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999999;
    opacity: 1;
    visibility: visible;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .modern-preloader.preloader--hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .modern-preloader__wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3.2rem;
  }

  .modern-preloader .loader {
    --d: 35px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    color: #997A51;
    box-shadow: 
      calc(1 * var(--d))      calc(0 * var(--d))     0 0   #997A51,
      calc(0.707 * var(--d))  calc(0.707 * var(--d)) 0 1.5px #997A51,
      calc(0 * var(--d))      calc(1 * var(--d))     0 3px #997A51,
      calc(-0.707 * var(--d)) calc(0.707 * var(--d)) 0 4.5px #997A51,
      calc(-1 * var(--d))     calc(0 * var(--d))     0 6px #997A51,
      calc(-0.707 * var(--d)) calc(-0.707 * var(--d)) 0 7.5px #997A51,
      calc(0 * var(--d))      calc(-1 * var(--d))    0 9px #997A51;
    animation: l27 1s infinite steps(8);
  }

  @keyframes l27 {
    100% { transform: rotate(1turn); }
  }

  .modern-preloader__title {
    font-family: var(--font-heading-family, 'DM Sans', sans-serif);
    font-size: 1.8rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #000000;
    margin: 0;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .modern-preloader__title {
      font-size: 2.0rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .modern-preloader .loader {
      animation-duration: 2s;
    }
  }
</style>

<div class="modern-preloader" id="ModernPreloader" aria-hidden="true">
  <div class="modern-preloader__wrapper">
    <div class="loader"></div>
    <span class="modern-preloader__title">The Golden Rug</span>
  </div>
</div>

<script>
  (function() {
    var preloader = document.getElementById('ModernPreloader');
    if (!preloader) return;

    var startTime = Date.now();
    var minDuration = 1000; // Guaranteed minimum 1000ms display time so full 1s cycle is seen
    var dismissed = false;

    function dismiss() {
      if (dismissed) return;
      dismissed = true;
      preloader.classList.add('preloader--hidden');
      setTimeout(function() {
        if (preloader && preloader.parentNode) {
          preloader.parentNode.removeChild(preloader);
        }
      }, 450);
    }

    function scheduleDismiss() {
      var elapsed = Date.now() - startTime;
      var remaining = Math.max(0, minDuration - elapsed);
      setTimeout(dismiss, remaining);
    }

    if (document.readyState === 'complete') {
      scheduleDismiss();
    } else {
      window.addEventListener('load', scheduleDismiss);
      // Safety fallback: dismiss after 2.5s so user is never blocked
      setTimeout(scheduleDismiss, 2500);
    }
  })();
</script>
