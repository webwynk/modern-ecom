{%- unless request.design_mode -%}
{% comment %}
  Deferred Luxury Site Preloader
  Brand: The Golden Rug (#997A51)
  Features:
    - High-performance, razor-sharp SVG vector 8-step radial multi-dot loader in brand highlight #997A51
    - Deferred Debounced Architecture:
        * Fast Internet (< 250ms): Preloader is cancelled instantly — 0 delay, 0 white screen, 0 flicker.
        * Slow Internet (> 250ms): Gold spinner smoothly fades in to reassure the visitor, then dissolves away.
    - Minimalist Luxury: Centered gold radial spinner only, no distracting text.
    - Fully accessible with aria-hidden="true" and reduced motion support.
{% endcomment %}

<style>
  .modern-preloader {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999999;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }

  .modern-preloader.preloader--visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .modern-preloader.preloader--hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .modern-preloader__wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modern-preloader__spinner {
    width: 48px;
    height: 48px;
    animation: modern-preloader-spin 1s infinite steps(8);
    transform-origin: center center;
    display: block;
  }

  @keyframes modern-preloader-spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .modern-preloader__spinner {
      animation-duration: 2s;
    }
  }
</style>

<div class="modern-preloader" id="ModernPreloader" aria-hidden="true">
  <div class="modern-preloader__wrapper">
    <svg class="modern-preloader__spinner" viewBox="0 0 50 50" fill="#997A51" xmlns="http://www.w3.org/2000/svg" role="presentation">
      <!-- 7 graduated radial dots with 8th position empty, creating the iconic stepping loader -->
      <circle cx="43" cy="25" r="1.75" />
      <circle cx="37.7" cy="37.7" r="2.25" />
      <circle cx="25" cy="43" r="2.75" />
      <circle cx="12.3" cy="37.7" r="3.25" />
      <circle cx="7" cy="25" r="3.75" />
      <circle cx="12.3" cy="12.3" r="4.25" />
      <circle cx="25" cy="7" r="4.75" />
    </svg>
  </div>
</div>

<script>
  (function() {
    var preloader = document.getElementById('ModernPreloader');
    if (!preloader) return;

    var threshold = 250; // Threshold in ms: only show preloader if page takes longer than 250ms
    var isShown = false;
    var isDismissed = false;

    // Fast vs Slow branch: schedule fade-in only if network/render is slow
    var showTimer = setTimeout(function() {
      if (!isDismissed) {
        isShown = true;
        preloader.classList.add('preloader--visible');
      }
    }, threshold);

    function cleanRemove() {
      if (preloader && preloader.parentNode) {
        preloader.parentNode.removeChild(preloader);
      }
    }

    function dismiss() {
      if (isDismissed) return;
      isDismissed = true;
      clearTimeout(showTimer);

      if (!isShown) {
        // Fast internet: page ready within 250ms, remove immediately without any white flash
        cleanRemove();
      } else {
        // Slow internet: spinner was shown, dissolve smoothly
        preloader.classList.remove('preloader--visible');
        preloader.classList.add('preloader--hidden');
        setTimeout(cleanRemove, 400);
      }
    }

    if (document.readyState === 'interactive' || document.readyState === 'complete') {
      dismiss();
    } else {
      document.addEventListener('DOMContentLoaded', dismiss);
      window.addEventListener('load', dismiss);
      // Hard fallback safety after 2.5s so visitor is never trapped
      setTimeout(dismiss, 2500);
    }
  })();
</script>
{%- endunless -%}
