  </ul>

  <!-- Main FAB Toggle Button -->
  <button
    type="button"
    class="support-fab__toggle"
    id="SupportFab-Toggle"
    aria-expanded="false"
    aria-controls="SupportFab-Menu"
    aria-label="Open support options"
  >
    <!-- Headset / Support Icon (shown when closed) -->
    <span class="support-fab__icon-open" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 11h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5Zm0 0a9 9 0 1 1 18 0m0 0v5a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3Z"/>
        <path d="M21 16v2a4 4 0 0 1-4 4h-5"/>
      </svg>
    </span>

    <!-- Close X Icon (shown when open) -->
    <span class="support-fab__icon-close" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </span>
  </button>
</div>

<script>
  (function() {
    'use strict';

    var fab = document.getElementById('SupportFab');
    var toggle = document.getElementById('SupportFab-Toggle');
    var backdrop = document.getElementById('SupportFab-Backdrop');
    var menuItems = fab.querySelectorAll('.support-fab__link');
    var scrollTopBtn = document.getElementById('footerScrollTop');

    function openFab() {
      fab.classList.add('support-fab--open');
      document.body.classList.add('support-fab-active');
      if (scrollTopBtn) {
        scrollTopBtn.style.opacity = '0';
        scrollTopBtn.style.visibility = 'hidden';
        scrollTopBtn.style.pointerEvents = 'none';
      }
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close support options');
      /* Enable tabbing into menu items */
      menuItems.forEach(function(item) { item.setAttribute('tabindex', '0'); });
      /* Focus the first menu item after a brief delay for animation */
      setTimeout(function() { menuItems[menuItems.length - 1].focus(); }, 200);
    }

    function closeFab() {
      fab.classList.remove('support-fab--open');
      document.body.classList.remove('support-fab-active');
      if (scrollTopBtn && window.pageYOffset > 400) {
        scrollTopBtn.style.opacity = '1';
        scrollTopBtn.style.visibility = 'visible';
        scrollTopBtn.style.pointerEvents = 'auto';
      }
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open support options');
      /* Disable tabbing into menu items */
      menuItems.forEach(function(item) { item.setAttribute('tabindex', '-1'); });
      toggle.focus();
    }

    function toggleFab() {
      if (fab.classList.contains('support-fab--open')) {
        closeFab();
      } else {
        openFab();
      }
    }

    /* Toggle on click */
    toggle.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      toggleFab();
    });

    /* Close on backdrop click */
    backdrop.addEventListener('click', function() {
      closeFab();
    });

    /* Close on Escape key */
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && fab.classList.contains('support-fab--open')) {
        closeFab();
      }
    });

    /* Close when clicking outside */
    document.addEventListener('click', function(e) {
      if (fab.classList.contains('support-fab--open') && !fab.contains(e.target)) {
        closeFab();
      }
    });
  })();
</script>
