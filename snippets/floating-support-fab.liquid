{% comment %}
  Floating Support FAB (Floating Action Button)
  SniMart E-Commerce — Global snippet rendered on every page via theme.liquid
  Design tokens: #997A51 gold accent, DM Sans, #000000, #FFFFFF
  Z-index: 9990 (below header 10000, drawer 99998, cart 100000)
{% endcomment %}

<style>
  /* ==========================================================================
     Floating Support FAB — Scoped Styles
     ========================================================================== */

  .support-fab {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 9990;
    font-family: var(--font-heading-family, 'DM Sans', sans-serif);
  }

  /* Backdrop overlay */
  .support-fab__backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.18);
    z-index: 9989;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
    pointer-events: none;
  }

  .support-fab--open .support-fab__backdrop {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Main toggle button */
  .support-fab__toggle {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: none;
    background-color: #997A51;
    color: #FFFFFF;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(153, 122, 81, 0.4), 0 2px 6px rgba(0, 0, 0, 0.08);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease, background-color 0.2s ease;
    position: relative;
    z-index: 9991;
    outline: none;
  }

  .support-fab__toggle:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 22px rgba(153, 122, 81, 0.5), 0 3px 10px rgba(0, 0, 0, 0.1);
  }

  .support-fab__toggle:focus-visible {
    box-shadow: 0 0 0 3px rgba(153, 122, 81, 0.4), 0 4px 16px rgba(153, 122, 81, 0.4);
  }

  .support-fab__toggle:active {
    transform: scale(0.96);
  }

  /* Icon swap on open/close */
  .support-fab__icon-open,
  .support-fab__icon-close {
    position: absolute;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .support-fab__icon-open svg,
  .support-fab__icon-close svg {
    width: 24px;
    height: 24px;
    display: block;
  }

  .support-fab__icon-open {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .support-fab__icon-close {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }

  .support-fab--open .support-fab__icon-open {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }

  .support-fab--open .support-fab__icon-close {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  /* Hide back to top when FAB is open to prevent collision */
  body.support-fab-active .footer-scroll-top-btn,
  .support-fab--open ~ footer .footer-scroll-top-btn {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  /* Menu container */
  .support-fab__menu {
    position: absolute;
    bottom: 64px;
    right: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-end;
    pointer-events: none;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .support-fab--open .support-fab__menu {
    pointer-events: auto;
  }

  /* Individual menu items */
  .support-fab__item {
    opacity: 0;
    transform: scale(0.5) translateY(12px);
    transition: opacity 0.25s ease, transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .support-fab--open .support-fab__item {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  .support-fab--open .support-fab__item:nth-child(1) { transition-delay: 0.04s; }
  .support-fab--open .support-fab__item:nth-child(2) { transition-delay: 0.1s; }
  .support-fab--open .support-fab__item:nth-child(3) { transition-delay: 0.16s; }

  /* Closing stagger (reverse) */
  .support-fab:not(.support-fab--open) .support-fab__item:nth-child(3) { transition-delay: 0s; }
  .support-fab:not(.support-fab--open) .support-fab__item:nth-child(2) { transition-delay: 0.04s; }
  .support-fab:not(.support-fab--open) .support-fab__item:nth-child(1) { transition-delay: 0.08s; }

  /* Menu option link pills */
  .support-fab__link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px 10px 14px;
    background-color: #FFFFFF;
    border: 1px solid #ECECEC;
    border-radius: 28px;
    text-decoration: none;
    color: #000000;
    font-family: var(--font-heading-family, 'DM Sans', sans-serif);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06), 0 1px 3px rgba(0, 0, 0, 0.04);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    line-height: 1;
  }

  .support-fab__link:hover {
    border-color: #997A51;
    box-shadow: 0 6px 20px rgba(153, 122, 81, 0.18), 0 2px 6px rgba(0, 0, 0, 0.06);
    transform: translateX(-3px);
  }

  .support-fab__link:focus-visible {
    outline: none;
    border-color: #997A51;
    box-shadow: 0 0 0 3px rgba(153, 122, 81, 0.25);
  }

  /* Link icon circles */
  .support-fab__link-icon {
    width: 32px;
    height: 32px;
    min-width: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .support-fab__link-icon svg {
    width: 16px;
    height: 16px;
  }

  /* Phone */
  .support-fab__link--phone .support-fab__link-icon {
    background-color: rgba(153, 122, 81, 0.12);
    color: #997A51;
  }
  .support-fab__link--phone:hover .support-fab__link-icon {
    background-color: #997A51;
    color: #FFFFFF;
  }

  /* Email */
  .support-fab__link--email .support-fab__link-icon {
    background-color: rgba(0, 0, 0, 0.07);
    color: #000000;
  }
  .support-fab__link--email:hover .support-fab__link-icon {
    background-color: #000000;
    color: #FFFFFF;
  }

  /* WhatsApp */
  .support-fab__link--whatsapp .support-fab__link-icon {
    background-color: rgba(37, 211, 102, 0.12);
    color: #25D366;
  }
  .support-fab__link--whatsapp:hover .support-fab__link-icon {
    background-color: #25D366;
    color: #FFFFFF;
  }

  /* Pulse ring animation on main FAB */
  .support-fab__toggle::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid rgba(153, 122, 81, 0.35);
    animation: supportFabPulse 2.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    pointer-events: none;
  }

  .support-fab--open .support-fab__toggle::before {
    animation: none;
    opacity: 0;
  }

  @keyframes supportFabPulse {
    0%, 100% { transform: scale(1); opacity: 0.6; }
    50% { transform: scale(1.25); opacity: 0; }
  }

  /* ==========================================================================
     Mobile (< 750px)
     ========================================================================== */

  @media screen and (max-width: 749px) {
    .support-fab {
      bottom: 16px;
      right: 16px;
    }

    .support-fab__toggle {
      width: 48px;
      height: 48px;
    }

    .support-fab__icon-open,
    .support-fab__icon-close {
      width: 22px;
      height: 22px;
    }

    .support-fab__icon-open svg,
    .support-fab__icon-close svg {
      width: 22px;
      height: 22px;
    }

    .support-fab__menu {
      bottom: 58px;
    }

    .support-fab__link {
      padding: 8px 14px 8px 10px;
      font-size: 12px;
      gap: 8px;
    }

    .support-fab__link-icon {
      width: 28px;
      height: 28px;
      min-width: 28px;
    }

    .support-fab__link-icon svg {
      width: 14px;
      height: 14px;
    }
  }

  /* Very small screens — hide labels */
  @media screen and (max-width: 399px) {
    .support-fab__link-text {
      display: none;
    }

    .support-fab__link {
      padding: 8px;
      border-radius: 50%;
    }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .support-fab__toggle,
    .support-fab__item,
    .support-fab__icon-open,
    .support-fab__icon-close,
    .support-fab__link,
    .support-fab__backdrop {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>

<div class="support-fab" id="SupportFab" aria-label="Support options">
