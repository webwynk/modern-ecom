{% comment %}
  Renders modern pill & circular pagination matching design reference
{% endcomment %}

{{ 'component-pagination.css' | asset_url | stylesheet_tag }}

{%- if paginate.parts.size > 0 -%}
  <div class="pagination-wrapper" data-page="{{ paginate.current_page }}">
    <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t | default: 'Pagination' }}">
      <ul class="pagination__list list-unstyled" role="list">
        {%- if paginate.previous -%}
          <li>
            <a
              href="{{ paginate.previous.url }}{{ anchor }}"
              class="pagination__item pagination__btn-pill pagination__btn-prev link motion-reduce"
              aria-label="{{ 'general.pagination.previous' | t | default: 'Previous' }}"
            >
              <svg class="icon icon-chevron" width="8" height="12" viewBox="0 0 8 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6.5 11L1.5 6L6.5 1"/>
              </svg>
              <span>Prev</span>
            </a>
          </li>
        {%- else -%}
          <li>
            <span class="pagination__item pagination__btn-pill pagination__btn-pill--disabled">
              <svg class="icon icon-chevron" width="8" height="12" viewBox="0 0 8 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6.5 11L1.5 6L6.5 1"/>
              </svg>
              <span>Prev</span>
            </span>
          </li>
        {%- endif -%}

        {%- for part in paginate.parts -%}
          <li>
            {%- if part.is_link -%}
              <a
                href="{{ part.url }}{{ anchor }}"
                class="pagination__item pagination__btn-circle link"
                aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
              >
                {{- part.title -}}
              </a>
            {%- else -%}
              {%- if part.title == paginate.current_page -%}
                <a
                  role="link"
                  aria-disabled="true"
                  class="pagination__item pagination__btn-circle pagination__item--current"
                  aria-current="page"
                  aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
                >
                  {{- part.title -}}
                </a>
              {%- else -%}
                <span class="pagination__item pagination__btn-circle pagination__btn-circle--ellipsis">{{ part.title }}</span>
              {%- endif -%}
            {%- endif -%}
          </li>
        {%- endfor -%}

        {%- if paginate.next -%}
          <li>
            <a
              href="{{ paginate.next.url }}{{ anchor }}"
              class="pagination__item pagination__btn-pill pagination__btn-next link motion-reduce"
              aria-label="{{ 'general.pagination.next' | t | default: 'Next' }}"
            >
              <span>Next</span>
              <svg class="icon icon-chevron" width="8" height="12" viewBox="0 0 8 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1.5 1L6.5 6L1.5 11"/>
              </svg>
            </a>
          </li>
        {%- else -%}
          <li>
            <span class="pagination__item pagination__btn-pill pagination__btn-pill--disabled">
              <span>Next</span>
              <svg class="icon icon-chevron" width="8" height="12" viewBox="0 0 8 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1.5 1L6.5 6L1.5 11"/>
              </svg>
            </span>
          </li>
        {%- endif -%}
      </ul>
    </nav>
  </div>
{%- endif -%}
